@model RollCall.Models.MeetingViewModel


<title>沛華集團抽籤系統</title>

@using PagedList.Mvc

@{
    // 計算起始的頁碼（根據當前頁數和每頁的大小）
    int pageNumber = Model.MeetingList.PageNumber;  // 當前頁數
    int pageSize = Model.MeetingList.PageSize;      // 每頁顯示的項目數量
    int index = (pageNumber - 1) * pageSize + 1;    // 計算當前頁面的起始頁碼
}

<style>
</style>

<link rel="stylesheet" href="~/Content/flatpickr.min.css">
<script src="~/Content/flatpickr.js"></script>
<script src="~/Content/zh-tw.js"></script>

@using (Html.BeginForm("SearchOrCreate", "RCS_MEETING", FormMethod.Post, new { enctype = "multipart/form-data", id = "searchCreateForm" }))
{
    @Html.AntiForgeryToken()
    <div style="margin-top: 20px; width: 100%;">
        <!-- 使用 flexbox 做出均勻排列 -->
        <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; max-width: 1600px; margin: 0 auto;">
            <!-- 會議名稱輸入框 -->
            <div class="form-group" style="">
                @Html.Label("會議名稱", htmlAttributes: new { @class = "control-label", @style = "text-align: left;" })
                <input type="text" id="meetingNameInput" name="NewMeeting.MEETING_NAME" class="form-control" placeholder="輸入會議名稱"
                       value="@Model.SearchMeetingName" style="width:240px;" />
                @Html.ValidationMessageFor(model => model.NewMeeting.MEETING_NAME, "", new { @class = "text-danger" })
            </div>


            @if (Session["Permission"].ToString() == "台北HR" || Session["Permission"].ToString() == "管理員")
            {
                <!-- 講師姓名輸入框 -->
                <div class="form-group">
                    @Html.Label("講師姓名", htmlAttributes: new { @class = "control-label", @style = "text-align: left;" })
                    <input type="text"
                           id="lecturerNameInput"
                           name="NewMeeting.LECTURER"
                           class="form-control"
                           placeholder="輸入講師姓名"
                           value="@Model.LECTURER"
                           style="width:240px;" />
                    @Html.ValidationMessageFor(model => model.NewMeeting.LECTURER, "", new { @class = "text-danger" })
                </div>
            }

            @section Scripts {
                <!-- jQuery UI (JS + CSS) -->
                <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css" />
                <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
                <script>
                    $(function () {
                        // 綁定 jQuery UI autocomplete 到 #lecturerNameInput
                        $("#lecturerNameInput").autocomplete({
                            // 告訴 autocomplete 要呼叫哪個後端 API
                            source: '@Url.Action("SearchLecturers", "RCS_MEETING")',

                            // 最少輸入幾個字再去查詢 (可自行調整)
                            minLength: 1,

                            // 可選：選擇某個選項時要做的動作
                            select: function (event, ui) {
                                // ui.item.value 即為選到的文字
                                console.log("使用者選了: " + ui.item.value);
                                // 你也可以做一些其它動作，如自動帶入其他欄位等
                            }
                        });
                    });
                </script>
            }

            <!-- 開始時間輸入框 -->
            <div class="form-group" style="">
                @Html.Label("開始時間", htmlAttributes: new { @class = "control-label", @style = "text-align: left;" })
                <input type="text" id="meetingStartInput" name="NewMeeting.MEETING_START" class="form-control"
                       value="@Model.SearchMeetingStart" style="width:240px;" />
                @Html.ValidationMessageFor(model => model.NewMeeting.MEETING_START, "", new { @class = "text-danger" })
            </div>

            <!-- 結束時間輸入框 -->
            <div class="form-group" style="">
                @Html.Label("結束時間", htmlAttributes: new { @class = "control-label", @style = "text-align: left;" })
                <input type="text" id="meetingEndInput" name="NewMeeting.MEETING_END" class="form-control"
                       value="@Model.SearchMeetingEnd" style="width:240px;" />
                @Html.ValidationMessageFor(model => model.NewMeeting.MEETING_END, "", new { @class = "text-danger" })
            </div>

            <!-- 建立會議按鈕 -->
            @if (Session["Permission"].ToString() == "台北HR" || Session["Permission"].ToString() == "管理員")
            {
                <div class="form-group" style=" text-align: center; margin-top: 22px;">
                    <button type="submit" name="action" value="create" class="btn btn-primary" style="" onclick="return validateMeetingForm()">建立會議</button>
                </div>
            }


            <!-- 搜尋會議按鈕 -->
            <div class="form-group" style=" text-align: center; margin-top: 22px;">
                <button type="submit" name="action" value="search" class="btn btn-info" onclick="return validateSearchForm()">搜尋會議</button>
            </div>


            @if (Session["Permission"].ToString() != "稽核")
            {
                <div class="form-group" style=" text-align: center; margin-top: 22px;">
                    <button type="button" class="btn btn-warning" onclick="redirectToEmployeesIndex()">前往員工資料表</button>
                </div>
            }


        </div>
    </div>
}

<!-- 會議紀錄表格 -->
<div style="max-width:1600px;">
    <table class="table table-striped table-bordered text-center" style="margin-top: 20px; text-align: center; vertical-align: middle;">
        <thead>
            <tr>
                <th style="text-align: center; vertical-align: middle;">No.</th>
                <th style="text-align: center; vertical-align: middle;">會議名稱</th>
                <th style="text-align: center; vertical-align: middle;">開始時間</th>
                <th style="text-align: center; vertical-align: middle;">結束時間</th>
                <th style="text-align: center; vertical-align: middle;">人員名單下載</th>
                <th style="text-align: center; vertical-align: middle;">編輯</th>
                <th style="text-align: center; vertical-align: middle;">會議連結</th>
                <th style="text-align: center; vertical-align: middle;">抽籤記錄下載</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var meeting in Model.MeetingList)
            {
                <tr>
                    <td style="vertical-align: middle;">@index</td>
                    <td style="vertical-align: middle;">@meeting.MEETING_NAME</td>

                    <!-- 開始時間，以 24 小時制顯示 -->
                    <td style="vertical-align: middle;">
                        @(meeting.MEETING_START.HasValue ? meeting.MEETING_START.Value.ToString("yyyy/MM/dd HH:mm:ss") : "")
                    </td>

                    <!-- 結束時間，以 24 小時制顯示 -->
                    <td style="vertical-align: middle;">
                        @(meeting.MEETING_END.HasValue ? meeting.MEETING_END.Value.ToString("yyyy/MM/dd HH:mm:ss") : "")
                    </td>

                    <!-- 人員名單下載按鈕 -->
                    <td style="vertical-align: middle;">
                        <a href="@Url.Action("DownloadMemberList", "RCS_MEETING", new { guid = meeting.AUTO_GUID })" class="btn btn-success">
                            人員名單
                        </a>
                    </td>

                    <!-- 如果會議尚未開始，顯示編輯和會議連結按鈕 -->
                    @if (meeting.MEETING_START > DateTime.Now || Session["Permission"].ToString() == "管理員")
                    {
                        <td style="vertical-align: middle;">
                            <a href="@Url.Action("Edit", "RCS_MEETING", new { guid = meeting.AUTO_GUID })" class="btn btn-danger">
                                編輯會議資料
                            </a>
                        </td>

                        <td style="vertical-align: middle;">
                            <a href="@Url.Action("DownloadMeetingLink", "RCS_MEETING", new { guid = meeting.AUTO_GUID })" class="btn btn-primary">
                                下載連結
                            </a>
                        </td>
                    }
                    else
                    {
                        <!-- 當會議已經開始，不顯示編輯和會議連結按鈕 -->
                        <td style="vertical-align: middle;"> </td>
                        <td style="vertical-align: middle;"> </td>
                    }

                    <!-- 抽籤記錄按鈕 -->
                    <td style="vertical-align: middle;">
                        <a href="@Url.Action("DownloadRaffleLog", "RCS_MEETING", new { guid = meeting.AUTO_GUID })" class="btn btn-success">
                            抽籤紀錄
                        </a>
                    </td>
                </tr>
                index++;
            }
        </tbody>
    </table>
</div>


<!-- 分頁功能控制項 -->
<div class="pagination-container" style="text-align:center">
    @Html.PagedListPager(Model.MeetingList, page => Url.Action("Index", new
    {
        page,
        search = Model.SearchMeetingName, // 保留搜尋條件
        searchStart = Model.SearchMeetingStart, // 保留開始時間
        searchEnd = Model.SearchMeetingEnd // 保留結束時間
    }))
</div>


<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        flatpickr("#meetingStartInput", {
            enableTime: true,
            time_24hr: true,
            dateFormat: "Y-m-d H:i",
            locale: "zh_tw"
        });

        flatpickr("#meetingEndInput", {
            enableTime: true,
            time_24hr: true,
            dateFormat: "Y-m-d H:i",
            locale: "zh_tw"
        });
    });

    function validateSearchForm() {
        var meetingName = document.getElementById('meetingNameInput').value.trim();
        var meetingStart = document.getElementById('meetingStartInput').value.trim();
        var meetingEnd = document.getElementById('meetingEndInput').value.trim();


        if (!meetingName && !meetingStart && !meetingEnd) {
            showModal('請至少輸入會議名稱、開始時間或結束時間中的一個條件');
            return false;
        }

        //如果有輸入開始與結束時間來作為條件搜尋，就需要防呆避免撈不出資料
        if (meetingStart && meetingEnd && meetingStart >= meetingEnd) {
            showModal('結束時間不得小於或等於開始時間');
            return false;
        }
        return true;
    }

    // 顯示Modal
    function showModal(message, duration = 3000) {
        document.getElementById('alertModalBody').innerText = message;

        setTimeout(function () {
            $('#alertModal').modal('show');
            setTimeout(function () {
                $('#alertModal').modal('hide');
            }, duration);
        }, 200);
    }

    // 防呆，建立會議資訊時，驗證會議名稱、開始與結束時間是否為空及是否已經上傳人員名單
    function validateMeetingForm() {
        var meetingName = document.getElementById('meetingNameInput').value;
        var lecturerName = document.getElementById('lecturerNameInput').value;
        var meetingStart = document.getElementById('meetingStartInput').value;
        var meetingEnd = document.getElementById('meetingEndInput').value;


        // 取得當前時間
        var currentTime = new Date();

        var meetingStartDate = new Date(meetingStart);
        var meetingEndDate = new Date(meetingEnd);

        if (!meetingName.trim()) {
            showModal('請輸入會議名稱');
            return false;
        }

        if (!lecturerName.trim()) {
            showModal('請輸入講師姓名');
            return false;
        }

        if (!meetingStart) {
            showModal('請選擇開始時間');
            return false;
        }

        if (!meetingEnd) {
            showModal('請選擇結束時間');
            return false;
        }

        if (meetingStartDate >= meetingEndDate) {
            showModal('結束時間不得小於或等於開始時間');
            return false;
        }

        if (meetingStartDate <= currentTime) {
            showModal('會議開始時間必須大於當前時間');
            return false;
        }

        showModal('成功建立會議資料');
        return true;
    }

    function redirectToEmployeesIndex() {
    // 使用 window.location.href 導向到 Create 頁面
    window.location.href = '@Url.Action("Index", "RCS_EMPLOYEES")';
}

</script>
