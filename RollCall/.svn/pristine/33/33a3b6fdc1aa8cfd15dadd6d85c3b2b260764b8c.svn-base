-- 一，欄位、條件約束、外鍵關聯異動

--移除RCS_CALL_LOG中的[RCS_MEMBER_UN2]條件約束
ALTER TABLE RCS_CALL_LOG DROP CONSTRAINT RCS_CALL_LOG_UN2;

--RCS_MEMBER中的[RCS_MEMBER_UN2]條件約束與[RCS_MEMBER_FK1]外鍵關聯
ALTER TABLE RCS_MEMBER DROP CONSTRAINT RCS_MEMBER_UN2;
ALTER TABLE RCS_MEMBER DROP CONSTRAINT RCS_MEMBER_FK1;


ALTER TABLE RCS_MEETING ADD LECTURER NVARCHAR(50) NULL; --新增講師欄位到RCS_MEETING中

ALTER TABLE RCS_MEMBER ADD MEETING_GROUP_AUTO_ID BIGINT NULL; --新增會議分組流水號欄位到RCS_MEMBER中
ALTER TABLE RCS_MEMBER ADD EMP_AUTO_ID BIGINT NULL;  -- 新增員工流水號到RCS_MEMBER中
ALTER TABLE RCS_MEMBER ADD SOURCE_GROUP_AUTO_ID BIGINT NULL; --新增常用組別流水號到RCS_MEMBER中

ALTER TABLE RCS_CALL_LOG ADD EMP_AUTO_ID BIGINT NULL; --新增員工流水號到RCS_CALL_LOG中
ALTER TABLE RCS_CALL_LOG ADD MEETING_GROUP_AUTO_ID BIGINT NULL; --新增會議分組流水號到RCS_CALL_LOG中

---------------------------------------------------------------------------------------------------------------------------------

-- 二，新增資料表

--員工資料表
CREATE TABLE RCS_EMPLOYEES (
    AUTO_ID BIGINT IDENTITY(1,1) NOT NULL,
    AUTO_GUID UNIQUEIDENTIFIER DEFAULT NEWID() NOT NULL,
    EMP_NAME NVARCHAR(20) NOT NULL,
    DEPARTMENT NVARCHAR(50) NOT NULL,
    POSITION NVARCHAR(50) NOT NULL,
    EMP_NUMBER NVARCHAR(10) NOT NULL,
    SALES_DEP_ID NVARCHAR(50) NOT NULL,
    REMARK NVARCHAR(MAX),
    IS_ACTIVED BIT DEFAULT 1 NOT NULL,
    CREATE_BY NVARCHAR(20) NOT NULL,
    CREATE_TIME DATETIME2 DEFAULT GETDATE() NOT NULL,
    MODIFY_BY NVARCHAR(20) NOT NULL,
    MODIFY_TIME DATETIME2 DEFAULT GETDATE() NOT NULL,
    IS_DELETED BIT DEFAULT 0 NOT NULL,
    DELETE_BY NVARCHAR(20),
    DELETE_TIME DATETIME2,
    CONSTRAINT RCS_EMPLOYEES_PK PRIMARY KEY (AUTO_ID),
    CONSTRAINT RCS_EMPLOYEES_UN1 UNIQUE (AUTO_GUID),
    CONSTRAINT RCS_EMPLOYEES_UN2 UNIQUE (EMP_NAME,EMP_NUMBER),
);

--常規組別
CREATE TABLE RCS_GROUP (
    AUTO_ID BIGINT IDENTITY(1,1) NOT NULL,
    AUTO_GUID UNIQUEIDENTIFIER DEFAULT NEWID() NOT NULL,
    GROUP_NAME NVARCHAR(20) NOT NULL,
    REMARK NVARCHAR(MAX),
    IS_ACTIVED BIT DEFAULT 1 NOT NULL,
    CREATE_BY NVARCHAR(20) NOT NULL,
    CREATE_TIME DATETIME2 DEFAULT GETDATE() NOT NULL,
    MODIFY_BY NVARCHAR(20) NOT NULL,
    MODIFY_TIME DATETIME2 DEFAULT GETDATE() NOT NULL,
    IS_DELETED BIT DEFAULT 0 NOT NULL,
    DELETE_BY NVARCHAR(20),
    DELETE_TIME DATETIME2,
    CONSTRAINT RCS_GROUP_PK PRIMARY KEY (AUTO_ID),
    CONSTRAINT RCS_GROUP_UN1 UNIQUE (AUTO_GUID),
);


--員工與常規組別對應表
CREATE TABLE RCS_EMPLOYEE_GROUP (
    AUTO_ID BIGINT IDENTITY(1,1) NOT NULL,
    AUTO_GUID UNIQUEIDENTIFIER DEFAULT NEWID() NOT NULL,
    EMP_AUTO_ID BIGINT NOT NULL,
    GROUP_AUTO_ID BIGINT NOT NULL,
    REMARK NVARCHAR(MAX),
    IS_ACTIVED BIT DEFAULT 1 NOT NULL,
    CREATE_BY NVARCHAR(20) NOT NULL,
    CREATE_TIME DATETIME2 DEFAULT GETDATE() NOT NULL,
    MODIFY_BY NVARCHAR(20) NOT NULL,
    MODIFY_TIME DATETIME2 DEFAULT GETDATE() NOT NULL,
    IS_DELETED BIT DEFAULT 0 NOT NULL,
    DELETE_BY NVARCHAR(20),
    DELETE_TIME DATETIME2,
    CONSTRAINT RCS_EMPLOYEE_GROUP_PK PRIMARY KEY (AUTO_ID),
    CONSTRAINT RCS_EMPLOYEE_GROUP_FK1 FOREIGN KEY (EMP_AUTO_ID) REFERENCES RCS_EMPLOYEES(AUTO_ID),
    CONSTRAINT RCS_EMPLOYEE_GROUP_FK2 FOREIGN KEY (GROUP_AUTO_ID) REFERENCES RCS_GROUP(AUTO_ID),
    CONSTRAINT RCS_EMPLOYEE_GROUP_UN1 UNIQUE (AUTO_GUID),
    CONSTRAINT RCS_EMPLOYEE_GROUP_UN2 UNIQUE (EMP_AUTO_ID,GROUP_AUTO_ID),
);



--會議組別
CREATE TABLE RCS_MEETING_GROUP (
    AUTO_ID BIGINT IDENTITY(1,1) NOT NULL,
    AUTO_GUID UNIQUEIDENTIFIER DEFAULT NEWID() NOT NULL,
    MEETING_AUTO_ID BIGINT NOT NULL,
    GROUP_NAME NVARCHAR(20) NOT NULL,
    REMARK NVARCHAR(MAX),
    IS_ACTIVED BIT DEFAULT 1 NOT NULL,
    CREATE_BY NVARCHAR(20) NOT NULL,
    CREATE_TIME DATETIME2 DEFAULT GETDATE() NOT NULL,
    MODIFY_BY NVARCHAR(20) NOT NULL,
    MODIFY_TIME DATETIME2 DEFAULT GETDATE() NOT NULL,
    IS_DELETED BIT DEFAULT 0 NOT NULL,
    DELETE_BY NVARCHAR(20),
    DELETE_TIME DATETIME2,
    CONSTRAINT RCS_MEETING_GROUP_PK PRIMARY KEY (AUTO_ID),
    CONSTRAINT RCS_MEETING_GROUP_FK1 FOREIGN KEY (MEETING_AUTO_ID) REFERENCES RCS_MEETING(AUTO_ID),
    CONSTRAINT RCS_MEETING_GROUP_UN1 UNIQUE (AUTO_GUID),
);

--會議組別與常規組別對應表
CREATE TABLE RCS_MEETING_GROUP_MAP (
    AUTO_ID BIGINT IDENTITY(1,1) NOT NULL,
    AUTO_GUID UNIQUEIDENTIFIER DEFAULT NEWID() NOT NULL,
    GROUP_AUTO_ID BIGINT NOT NULL,
    MEETING_GROUP_AUTO_ID BIGINT NOT NULL,
    REMARK NVARCHAR(MAX),
    IS_ACTIVED BIT DEFAULT 1 NOT NULL,
    CREATE_BY NVARCHAR(20) NOT NULL,
    CREATE_TIME DATETIME2 DEFAULT GETDATE() NOT NULL,
    MODIFY_BY NVARCHAR(20) NOT NULL,
    MODIFY_TIME DATETIME2 DEFAULT GETDATE() NOT NULL,
    IS_DELETED BIT DEFAULT 0 NOT NULL,
    DELETE_BY NVARCHAR(20),
    DELETE_TIME DATETIME2,
    CONSTRAINT RCS_MEETING_GROUP_MAP_PK PRIMARY KEY (AUTO_ID),
    CONSTRAINT RCS_MEETING_GROUP_MAP_FK1 FOREIGN KEY (GROUP_AUTO_ID) REFERENCES RCS_GROUP(AUTO_ID),
    CONSTRAINT RCS_MEETING_GROUP_MAP_FK2 FOREIGN KEY (MEETING_GROUP_AUTO_ID) REFERENCES RCS_MEETING_GROUP(AUTO_ID),
    CONSTRAINT RCS_MEETING_GROUP_MAP_UN1 UNIQUE (AUTO_GUID),
    CONSTRAINT RCS_MEETING_GROUP_MAP_UN2 UNIQUE (MEETING_GROUP_AUTO_ID,GROUP_AUTO_ID),
);
---------------------------------------------------------------------------------------------------------------------------------
-- 三，修復資料

-- 1.先在新版系統中上傳名冊，執行專案後進入(RCS_EMPLOYEES/UploadEmployeeList)上傳名冊(專案Content/files底下有)

-- 2.用MEMBER_NAME比對員工姓名，指派員工流水號到RCS_MEMBER的EMP_AUTO_ID中
UPDATE RCS_MEMBER
SET EMP_AUTO_ID = RCS_EMPLOYEES.AUTO_ID
FROM RCS_EMPLOYEES
WHERE MEMBER_NAME = RCS_EMPLOYEES.EMP_NAME

-- 3.從RCS_MEMBER的AUTO_ID關聯RCS_CALL_LOG中的MEMBER_AUTO_ID
-- 再根據"RCS_EMPLOYEES的EMP_NAME"查詢出與"RCS_MEMBER的MEMBER_NAME"相同的員工流水號指派到RCS_CALL_LOG新增的EMP_AUTO_ID欄位
UPDATE RCS_CALL_LOG
SET EMP_AUTO_ID = E.AUTO_ID
FROM RCS_CALL_LOG AS C
INNER JOIN RCS_MEMBER AS M ON C.MEMBER_AUTO_ID = M.AUTO_ID
INNER JOIN RCS_EMPLOYEES AS E ON M.MEMBER_NAME = E.EMP_NAME
WHERE C.EMP_AUTO_ID IS NULL

-- 4.用RCS_MEMBER的MEETING_AUTO_ID與GROUP_NAME來新增舊版的會議資料到MEETING_GROUP(會議組別)中，因為新版抽籤記錄需要從會議組別找出組別名稱
INSERT INTO RCS_MEETING_GROUP (MEETING_AUTO_ID, GROUP_NAME, IS_ACTIVED, CREATE_BY, CREATE_TIME, MODIFY_BY, MODIFY_TIME)
SELECT 
    M.MEETING_AUTO_ID,
    M.GROUP_NAME,
    1 AS IS_ACTIVED,
    'System' AS CREATE_BY,
    GETDATE() AS CREATE_TIME,
    'System' AS MODIFY_BY,
    GETDATE() AS MODIFY_TIME
FROM RCS_MEMBER AS M
LEFT JOIN RCS_MEETING_GROUP AS MG
    ON M.MEETING_AUTO_ID = MG.MEETING_AUTO_ID
    AND M.GROUP_NAME = MG.GROUP_NAME
WHERE MG.AUTO_ID IS NULL
GROUP BY M.MEETING_AUTO_ID, M.GROUP_NAME

-- 5.以RCS_MEETING_GROUP的新增的舊版會議資料根據會議流水號與組別名稱進行關聯，因為新版RCS_MEMBER多了會議組別流水號
-- 將會議用分組的流水號增加到RCS_MEMBER新增的MEETING_GROUP_AUTO_ID欄位中
UPDATE RCS_MEMBER
SET RCS_MEMBER.MEETING_GROUP_AUTO_ID = MG.AUTO_ID
FROM RCS_MEMBER
INNER JOIN RCS_MEETING_GROUP AS MG
    ON RCS_MEMBER.MEETING_AUTO_ID = MG.MEETING_AUTO_ID
    AND RCS_MEMBER.GROUP_NAME = MG.GROUP_NAME
WHERE RCS_MEMBER.MEETING_GROUP_AUTO_ID IS NULL

-- 6.以RCS_MEMBER的EMP_AUTO_ID關聯RCS_CALL_LOG中的EMP_AUTO_ID，因為新版抽籤記錄改為記錄"會議組別流水號"
-- 再以RCS_MEMBER的MEETING_AUTO_ID和GROUP_NAME關聯會議用分組的MEETING_AUTO_ID與GROUP_NAME
UPDATE CL
SET CL.MEETING_GROUP_AUTO_ID = MG.AUTO_ID
FROM RCS_CALL_LOG AS CL
INNER JOIN RCS_MEMBER AS M
    ON CL.MEMBER_AUTO_ID = M.AUTO_ID
INNER JOIN RCS_MEETING_GROUP AS MG
    ON M.MEETING_AUTO_ID = MG.MEETING_AUTO_ID
    AND M.GROUP_NAME = MG.GROUP_NAME
WHERE CL.MEETING_GROUP_AUTO_ID IS NULL

-- 7.個案處理
-- 離職人員(已加入名冊，可以略過)
SELECT * FROM RCS_EMPLOYEES WHERE EMP_NAME LIKE N'%彭郁慈、何沛璇%'

--原始名單名字打錯
--徐郁琁(正確) 徐郁璇(錯誤)
UPDATE RCS_MEMBER SET MEMBER_NAME = '徐郁琁' WHERE MEMBER_NAME = '徐郁璇'

--查出被抽到的會議成員流水號和名字
SELECT DISTINCT MEMBER_AUTO_ID, GROUP_NAME,　MEMBER_NAME　, RCS_CALL_LOG.CREATE_TIME
FROM RCS_CALL_LOG 
LEFT JOIN RCS_MEMBER
ON RCS_MEMBER.AUTO_ID = RCS_CALL_LOG.MEMBER_AUTO_ID
WHERE RCS_MEMBER.CREATE_TIME > '2024/10/15' AND MEMBER_NAME LIKE N'%%'
AND RCS_MEMBER.MEETING_AUTO_ID NOT IN (178,179,185,188,189,191)


--查被抽到的新進或離職人員
SELECT DISTINCT MEMBER_AUTO_ID, GROUP_NAME ,MEMBER_NAME , RCS_CALL_LOG.CREATE_TIME
FROM RCS_CALL_LOG 
LEFT JOIN RCS_MEMBER
ON RCS_MEMBER.AUTO_ID = RCS_CALL_LOG.MEMBER_AUTO_ID
WHERE RCS_MEMBER.CREATE_TIME > '2024/10/15' AND MEMBER_NAME LIKE N'%%' AND RCS_MEMBER.EMP_AUTO_ID IS NULL
AND RCS_MEMBER.MEETING_AUTO_ID NOT IN (178,179,185,188,189,191) --這幾筆為假資料的流水號

--查總經理業屬
SELECT * FROM RCS_EMPLOYEES WHERE SALES_DEP_ID LIKE N'%總經理%'


--更新總經理業屬
UPDATE RCS_EMPLOYEES SET SALES_DEP_ID = 'PS.PTE' WHERE EMP_NAME = '劉曜誠'
UPDATE RCS_EMPLOYEES SET SALES_DEP_ID = 'PS.PTE' WHERE EMP_NAME = '楊曜州'
UPDATE RCS_EMPLOYEES SET SALES_DEP_ID = 'PS.TXG' WHERE EMP_NAME = '胡志宏'
UPDATE RCS_EMPLOYEES SET SALES_DEP_ID = 'PC.TXG' WHERE EMP_NAME = '徐明鴻'
UPDATE RCS_EMPLOYEES SET SALES_DEP_ID = 'PS.KHH' WHERE EMP_NAME = '高美如'
UPDATE RCS_EMPLOYEES SET SALES_DEP_ID = 'PC.KHH' WHERE EMP_NAME = '楊宏緒'
UPDATE RCS_EMPLOYEES SET SALES_DEP_ID = 'PS.PTE' WHERE EMP_NAME = '汪秋月'


-- 8.復原完成後直接再次執行步驟2、3、5、6即可在抽籤記錄撈到缺失的資料

