-- 四、使用新版後可能需要處理的內容

-- 查有加入會議的新進或離職人員
SELECT MEETING_NAME,GROUP_NAME,MEMBER_NAME
FROM RCS_MEETING
LEFT JOIN RCS_MEMBER
ON MEETING_AUTO_ID = RCS_MEETING.AUTO_ID
WHERE EMP_AUTO_ID IS NULL AND RCS_MEETING.CREATE_TIME > '2024/10/15' AND MEETING_AUTO_ID NOT IN (178,179,185,188,189,191)--這幾筆為假資料的流水號


--調整員工資料CREATE_BY欄位

UPDATE RCS_EMPLOYEES SET CREATE_BY = '高雄HR' WHERE SALES_DEP_ID LIKE N'%KHH%'
UPDATE RCS_EMPLOYEES SET CREATE_BY = '台中HR' WHERE SALES_DEP_ID LIKE N'%TXG%'


