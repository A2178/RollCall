@model RollCall.Models.MeetingEditViewModel

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/flatpickr.min.css">
<script src="~/Content/flatpickr.js"></script>
<script src="~/Content/zh-tw.js"></script>


<style>

    .horizontal-item {
        font-size: 22px;
    }

    /* 固定表頭的樣式 */
    .table-fixed-header thead th {
        position: sticky;
        top: 0;
        background-color: #fff; /* 背景顏色防止內容與表頭重疊 */
        z-index: 2;
        box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.1); /* 添加陰影效果，讓表頭更加突出 */
    }

    .table-centered th, .table-centered td {
        text-align: center; /* 置中表格所有內容 */
        vertical-align: middle; /* 垂直置中 */
    }

    thead th {
        position: sticky;
        top: 0;
        background-color: white;
        z-index: 100;
        border: 2px solid #dee2e6; /* 確保有明顯的邊框 */
        padding: 10px; /* 避免內容過於靠近邊框 */
    }

    tbody td {
        border: 1px solid #dee2e6;
        padding: 10px; /* 增加內邊距，讓內容不至於過於貼近邊框 */
    }

    table {
        border-collapse: separate; /* 使用 separate 避免 border-collapse 影響 sticky */
        width: 100%;
        border-spacing: 0; /* 防止表格之間的空隙 */
    }
</style>

@using (Html.BeginForm("Edit", "RCS_MEETING", FormMethod.Post, new { @id = "editForm" }))
{
    @Html.AntiForgeryToken()

    <h1><strong>編輯會議記錄</strong></h1>

    <div class="form-horizontal" style="margin-right:20px;">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- 隱藏欄位：會議主檔主鍵 -->
        @Html.HiddenFor(model => model.Meeting.AUTO_ID)
        @Html.HiddenFor(model => model.Meeting.AUTO_GUID)

        <!-- 會議基本資料 -->
        <h3><strong>會議基本資料</strong></h3>

        <div class="form-group horizontal-group" style="display: flex; justify-content: space-between; gap: 20px;">
            <!-- 會議名稱 -->
            <div class="horizontal-item" style="flex: 1;">
                <label for="MeetingName">會議名稱</label>
                @Html.EditorFor(m => m.Meeting.MEETING_NAME, new { htmlAttributes = new { @class = "form-control", @id = "meetingNameInput" } })
                @Html.ValidationMessageFor(m => m.Meeting.MEETING_NAME, "", new { @class = "text-danger" })
            </div>

            <!-- 開始時間 -->
            <div class="horizontal-item" style="flex: 1;">
                <label for="MeetingStart">開始時間</label>
                <input type="text" id="meetingStartInput" class="form-control"
                       name="Meeting.MEETING_START"
                       value="@Model.Meeting.MEETING_START?.ToString(" yyyy-MM-dd HH:mm")" />
                @Html.ValidationMessageFor(m => m.Meeting.MEETING_START, "", new { @class = "text-danger" })
            </div>

            <!-- 結束時間 -->
            <div class="horizontal-item" style="flex: 1;">
                <label for="MeetingEnd">結束時間</label>
                <input type="text" id="meetingEndInput" class="form-control"
                       name="Meeting.MEETING_END"
                       value="@Model.Meeting.MEETING_END?.ToString(" yyyy-MM-dd HH:mm")" />
                @Html.ValidationMessageFor(m => m.Meeting.MEETING_END, "", new { @class = "text-danger" })
            </div>

            <!-- 保存會議資料 -->
            <div class="horizontal-item" style="flex: 1;">
                <button type="button" class="btn btn-success" style="margin-top: 35px;" onclick="updateMeeting()">保存會議資料</button>
            </div>
        </div>

        <hr style="border: 1px solid lightgray;" />

        <!-- 群組搜尋&群組選擇區塊 (對應RCS_GROUP) -->
        <div class="form-group horizontal-group" style="display: flex; justify-content: flex-start; gap: 20px; margin-bottom: 20px;">
            <!-- 搜尋群組名稱輸入框 -->
            <div class="horizontal-item" style="flex: 1;">
                <label for="groupNameFilter">搜尋群組名稱</label>
                <input type="text" id="groupNameFilter" class="form-control" placeholder="請輸入關鍵字..." />
            </div>

            <!-- 搜尋按鈕 -->
            <div class="horizontal-item" style="flex: 1;">
                <label>&nbsp;</label>
                <button type="button" class="btn btn-primary form-control" style="width:100px; margin-top:35px;" onclick="searchGroups()">搜尋</button>
            </div>

            <!-- 自定義群組下拉選單 -->
            <div class="horizontal-item" style="flex: 1;">
                <label for="groupNameDropdown">群組清單</label>
                <select id="groupNameDropdown" class="form-control">
                    <option value="">請選擇群組</option>
                    @if (Model.GroupList != null && Model.GroupList.Any())
                    {
                        foreach (var group in Model.GroupList)
                        {
                            <option value="@group.AUTO_ID">@group.GROUP_NAME</option>
                        }
                    }
                </select>
            </div>

            <div class="horizontal-item" style="flex: 1;">
                <label>&nbsp;</label>
                <button type="button" class="btn btn-info form-control" style="width:150px; margin-top:35px;" onclick="addGroupToMeeting()">加入此群組至會議</button>
            </div>
        </div>

        <hr style="border: 1px solid lightgray;" />
        <h3><strong>與會人員名單</strong></h3>

        @if (Model.MeetingGroups != null && Model.MeetingGroups.Any())
        {
            foreach (var mg in Model.MeetingGroups)
            {
                <div class="meeting-group-section" style="margin-bottom: 20px;">
                    <h4>@mg.GROUP_NAME</h4>

                    <!-- 此群組底下的成員清單 -->
                    @if (mg.Members != null && mg.Members.Any())
                    {
                        <table class="table table-bordered table-centered">
                            <thead>
                                <tr>
                                    <th>成員名稱</th>
                                    <th>動作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mem in mg.Members)
                                {
                                    <tr>
                                        <td>@mem.EmployeeName</td>
                                        <td>
                                            <button type="button" class="btn btn-warning"
                                                    onclick="editMember('@mem.EmployeeName', '@mg.GROUP_NAME', '@mem.MemberAutoId')">
                                                編輯
                                            </button>
                                            <button type="button" class="btn btn-danger"
                                                    onclick="removeMember('@mem.MemberAutoId', '@mg.AUTO_ID')">
                                                刪除
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>目前該分組沒有成員。</p>
                    }
                </div>
            }
        }
        else
        {
            <p>您目前尚未加入任何成員至該場會議。</p>
        }

        <div class="form-group" style="padding: 10px;">
            <input type="hidden" id="editingMemberId" value="" />

            <div style="display:flex;">
                <div style="margin-left:70%; width:200px;">
                    <label for="originalMemberName">原始名稱</label>
                    <input type="text" id="originalMemberName" class="form-control" style="background-color:lightgray;" readonly />

                    <label for="originalGroupName" style="margin-top: 10px;">原始組別名稱</label>
                    <input type="text" id="originalGroupName" class="form-control" style="background-color: lightgray;" readonly />
                </div>

                <div style="margin-left: 50px; width: 200px;">
                    <label for="newMemberName">新增/修改成員</label>
                    <input type="text" id="newMemberName" class="form-control" placeholder="輸入成員名稱" />

                    <label for="newGroupName" style="margin-top: 10px;">新增/修改成員分組</label>
                    <input type="text" id="newGroupName" class="form-control" placeholder="輸入分組名稱" />

                    <!-- 新增/修改按鈕 -->
                    <button type="button" class="btn btn-success" style="margin-top: 10px;" onclick="addOrUpdateMember()">新增/修改</button>
                </div>
            </div>

            <!-- 返回會議記錄頁面 -->
            <div class="row" style="margin-top: 20px; margin-left: 91%;">
                <div class="col-md-5 offset-md-6">
                    <button type="button" class="btn btn-info" onclick="redirectToMeetingRecords()">返回會議記錄</button>
                </div>
            </div>
        </div>
    </div>
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            var meetingStart = '@(Model.Meeting.MEETING_START.HasValue ? Model.Meeting.MEETING_START.Value.ToString("yyyy-MM-dd HH:mm") : "")';
            var meetingEnd = '@(Model.Meeting.MEETING_END.HasValue ? Model.Meeting.MEETING_END.Value.ToString("yyyy-MM-dd HH:mm") : "")';

            flatpickr("#meetingStartInput", {
                enableTime: true,
                time_24hr: true,
                locale: "zh_tw",
                dateFormat: "Y-m-d H:i",
                defaultDate: meetingStart
            });

            flatpickr("#meetingEndInput", {
                enableTime: true,
                time_24hr: true,
                locale: "zh_tw",
                dateFormat: "Y-m-d H:i",
                defaultDate: meetingEnd
            });
        });

        // 1. 顯示提示訊息 (Modal)
        function showModal(message, duration = 3000) {
            document.getElementById('alertModalBody').innerText = message;

            setTimeout(function () {
                $('#alertModal').modal('show');
                setTimeout(function () {
                    $('#alertModal').modal('hide');
                }, duration);
            }, 200);
        }

        // 2. 返回會議記錄頁面
        function redirectToMeetingRecords() {
            var today = new Date();
            var year = today.getFullYear();
            var month = String(today.getMonth() + 1).padStart(2, '0');
            var day = String(today.getDate()).padStart(2, '0');
            var hours = '00';
            var minutes = '00';

            var searchStart = `${year}-${month}-${day} ${hours}:${minutes}`;
            window.location.href = '@Url.Action("Index", "RCS_MEETING")' + '?searchStart=' + encodeURIComponent(searchStart);
        }


        //搜尋自定義群組 (RCS_GROUP)
        function searchGroups() {
            var keyword = $('#groupNameFilter').val();
            $.ajax({
                url: '@Url.Action("SearchGroup", "RCS_MEETING")',
                type: 'GET',
                data: { keyword: keyword },
                success: function (data) {
                    // 包含篩選後的 RCS_GROUP 清單
                    // 清空下拉
                    $('#groupNameDropdown').empty();
                    $('#groupNameDropdown').append('<option value="">請選擇群組</option>');
                    if (data && data.length > 0) {
                        $.each(data, function (i, group) {
                            // group.AUTO_ID, group.GROUP_NAME
                            $('#groupNameDropdown').append(
                                `<option value="${group.AUTO_ID}">${group.GROUP_NAME}</option>`
                            );
                        });
                    }
                },
                error: function () {
                    showModal("搜尋群組發生錯誤。");
                }
            });
        }

        // 從自定義群組加入到這次會議
        function addGroupToMeeting() {
            var selectedGroupId = $('#groupNameDropdown').val(); // RCS_GROUP.AUTO_ID
            if (!selectedGroupId) {
                showModal("請先選擇一個自定義群組");
                return;
            }

            var meetingId = '@Model.Meeting.AUTO_ID'; // 目前正在編輯的會議

            // 呼叫後端，將該 groupId 對應的員工都加到本會議
            // 也會在後端同時建立 RCS_MEETING_GROUP_MAP (群組-會議群組對應)
            $.ajax({
                url: '@Url.Action("AddGroupToMeeting", "RCS_MEETING")',
                type: 'POST',
                data: {
                    meetingId: meetingId,
                    groupId: selectedGroupId
                },
                success: function (res) {
                    if (res.success) {
                        showModal("已將自定義群組加入到本會議！");
                        setTimeout(function () {
                            location.reload();
                        }, 1500);
                    } else {
                        showModal("加入群組失敗：" + (res.message || ""));
                    }
                },
                error: function () {
                    showModal("加入群組時發生錯誤。");
                }
            });
        }

        //刪除某個成員(帶上 meetingGroupId)
        var memberToDeleteId = null;
        var meetingGroupIdToDelete = null;

        function removeMember(memberId, meetingGroupId) {
            memberToDeleteId = memberId;
            meetingGroupIdToDelete = meetingGroupId;
            $('#confirmDeleteModal').modal('show');
        }

        // 確認刪除
        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            if (memberToDeleteId && meetingGroupIdToDelete) {
                $.post('@Url.Action("RemoveMember", "RCS_MEETING")',
                    {
                        memberId: memberToDeleteId,
                        meetingGroupId: meetingGroupIdToDelete
                    },
                    function (data) {
                        if (data.success) {
                            $('#confirmDeleteModal').modal('hide');
                            location.reload();
                        } else {
                            $('#confirmDeleteModal').modal('hide');
                            showModal("刪除失敗");
                        }
                    }
                );
            }
        });

        //編輯成員
        function editMember(memberName, groupName, memberId) {
            $('#originalMemberName').val(memberName);
            $('#originalGroupName').val(groupName);
            $('#newMemberName').val(memberName);
            $('#newGroupName').val(groupName);
            $('#editingMemberId').val(memberId);
        }

        //新增/修改成員
function addOrUpdateMember() {
    var memberName = $('#newMemberName').val();
    var groupName = $('#newGroupName').val();
    var editingMemberId = $('#editingMemberId').val();

    // 先檢查成員名稱
    if (!memberName) {
        showModal("請輸入成員名稱");
        return;
    }

    //前端檢查：組別名稱是否限定在以下六種結果
    var allowedGroups = ["PS.TPE", "PC.TPE", "PS.TXG", "PC.TXG", "PS.KHH", "PC.KHH"];
    if (groupName && !allowedGroups.includes(groupName)) {
        showModal("組別名稱錯誤，請輸入以下六種結果之一：\n" + allowedGroups.join(", "));
        return;
    }

    // if (!groupName) {
    //     showModal("請輸入組別名稱");
    //     return;
    // }

    // 若都通過檢查，就可以進行 AJAX 呼叫
    $.ajax({
        url: '@Url.Action("AddOrUpdateMember", "RCS_MEETING")',
        type: 'POST',
        data: {
            meetingId: '@Model.Meeting.AUTO_ID',
            memberName: memberName,
            groupName: groupName,
            editingMemberId: editingMemberId
        },
        success: function (data) {
            if (data.success) {
                showModal("新增/更改成員資料成功！");
                setTimeout(function () {
                    location.reload();
                }, 2000);
            } else {
                showModal("操作失敗: " + data.message);
            }
        },
        error: function () {
            showModal("操作發生錯誤");
        }
    });
}


        //更新會議
        function updateMeeting() {
            var meetingId = '@Model.Meeting.AUTO_ID';
            var meetingName = $('#meetingNameInput').val();
            var meetingStart = $('#meetingStartInput').val();
            var meetingEnd = $('#meetingEndInput').val();

            var meetingStartDate = new Date(meetingStart);
            var meetingEndDate = new Date(meetingEnd);

            if (!meetingName || !meetingStart || !meetingEnd) {
                showModal("請確認所有欄位已填寫完整");
                return;
            }

            if (meetingStartDate >= meetingEndDate) {
                showModal("結束時間不得小於或等於開始時間");
                return;
            }

            $.ajax({
                url: '@Url.Action("Edit", "RCS_MEETING")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                    Meeting: {
                        AUTO_ID: meetingId,
                        MEETING_NAME: meetingName,
                        MEETING_START: meetingStart,
                        MEETING_END: meetingEnd
                    }
                },
                success: function (response) {
                    if (response.success) {
                        showModal("會議資料更新成功！");
                        setTimeout(function() {
                            location.reload();
                        }, 2000);
                    } else {
                        showModal("更新失敗：" + response.message);
                    }
                },
                error: function () {
                    showModal("操作失敗，請稍後重試。");
                }
            });
        }
    </script>
}

