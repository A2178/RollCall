@model IPagedList<RollCall.Models.EmployeeViewModel>

@using PagedList.Mvc
@using PagedList

@{
    ViewBag.Title = "員工資料";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>員工資料</h2>

<!-- 搜索功能 -->
<form method="get">
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-top: 20px;">

        <div style="display: flex; gap:10px; align-items: center; margin-bottom: 20px;">
            <!-- 搜尋 -->
            <label for="search">搜尋員工資料：</label>
            <input type="text" name="search" class="form-control"
                   value="@Request.QueryString["search"]"
                   placeholder="搜尋姓名、部門、業屬或員工編號"
                   style="padding: 5px; width: 250px;" />

            <!-- 業屬篩選下拉 -->
            <label for="depFilter" style="margin-left:10px;">業屬篩選：</label>
            @{
                // 取出當前 depFilter
                var currentDepFilter = Request.QueryString["depFilter"] ?? "";
            }
            <select id="depFilter" name="depFilter" class="form-control" style="width: 100px;">
                <option value="" @(string.IsNullOrEmpty(currentDepFilter) ? "selected" : "")>所有</option>
                <option value="PS" @(currentDepFilter == "PS" ? "selected" : "")>PS</option>
                <option value="PC" @(currentDepFilter == "PC" ? "selected" : "")>PC</option>
            </select>

            <!-- 搜索按鈕 -->
            <button id="searchButton" type="submit" class="btn btn-primary" style="padding: 6px 12px;">
                搜尋
            </button>
        </div>

        <!-- 每頁顯示筆數選擇 + 其他按鈕 -->
        <div style="display: flex; gap: 10px; align-items: center;">
            <label for="pageSizeSelector">每頁顯示筆數：</label>
            <select id="pageSizeSelector" name="pageSize" class="form-control" style="width: 100px;" onchange="updatePageSize()">
                <option value="10" @(Request.QueryString["pageSize"] == "10" ? "selected" : "")>10</option>
                <option value="20" @(Request.QueryString["pageSize"] == "20" ? "selected" : "")>20</option>
                <option value="50" @(Request.QueryString["pageSize"] == "50" ? "selected" : "")>50</option>
                <option value="100" @(Request.QueryString["pageSize"] == "100" ? "selected" : "")>100</option>
            </select>

            <div id="otherPageSection" style="display:block;">
                <button type="button" class="btn btn-success" onclick="redirectToCreate()">新增員工資料</button>
                <button type="button" class="btn btn-warning" onclick="redirectToMeeting()">會議記錄頁面</button>
            </div>
        </div>

    </div>
</form>


<!-- 新增組別 -->
<div style="margin-bottom: 20px;">
    <label for="newGroupName">新增常用組別：</label>
    <input type="text" id="newGroupName" class="form-control" style="width: 300px; display: inline-block;" placeholder="輸入組別名稱" />
    <button id="addGroupButton" class="btn btn-success" onclick="addGroup()" style="margin-bottom:1px">新增組別</button>
</div>



<!-- 選擇並編輯組別 -->
<div style="margin-bottom: 20px;">
    <label for="groupSelector">選擇常用組別：</label>
    <select id="groupSelector" class="form-control" style="width: 300px; display: inline-block;">
        <option value="" @(string.IsNullOrEmpty(ViewBag.SelectedGroup) ? "selected" : "")>請選擇組別</option>
        @if (ViewBag.Groups is List<string> groups && groups.Any())
        {
            foreach (var group in groups)
            {
                <option value="@group" @(group == (ViewBag.SelectedGroup ?? "").ToString() ? "selected" : "")>@group</option>
            }
        }
    </select>

    @if (!(ViewBag.FilterByGroup ?? false)) // 當不在分組篩選模式下時顯示
    {
        <button type="button" id="editGroupButton" class="btn btn-success" onclick="editGroup()">新增組別成員</button>
    }
    <button type="button" id="SearchGroupButton" class="btn btn-info" onclick="filterByGroup()">查詢組別成員</button>
    <button type="button" id="deleteDailyGroupButton" class="btn btn-danger" onclick="deleteDailyGroup()">
        刪除常用組別
    </button>
</div>


<!-- 保存分組按鈕 -->
<div id="saveGroupSection" style="display: none; margin-top: 20px;">
    <button type="button" id="selectAllButton" class="btn btn-info" onclick="selectAllCheckboxes()">全選當前頁</button>
    <button type="button" id="clearSelectionButton" class="btn btn-warning" onclick="clearAllSelection()">取消全選</button>
    <button type="button" id="saveGroupButton" class="btn btn-success" onclick="saveGroup()">保存組別</button>
    <button type="button" id="exitEditModeButton" class="btn btn-danger" onclick="exitEditMode()">退出新增模式</button>
</div>

<button type="button" id="exitSearchModeButton" style="display: none;" class="btn btn-danger" onclick="exitSearchMode()">退出查詢模式</button>

<!-- 員工資料表 -->
<table class="table table-striped table-bordered text-center" style="margin-top: 20px;">
    <thead>
        <tr>
            @if (ViewBag.IsEditing || ViewBag.FilterByGroup)
            {
                <th style="text-align:center;">選擇</th>
            }
            <th style="text-align:center;">姓名</th>
            <th style="text-align:center;">航線</th>
            <th style="text-align:center;">職務</th>
            <th style="text-align:center;">員工編號</th>
            <th style="text-align:center;">業務所屬部門</th>
            @if (!(ViewBag.IsEditing || ViewBag.FilterByGroup))
            {
                <th style="text-align:center;">操作</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                @if (ViewBag.IsEditing || ViewBag.FilterByGroup)
                {
                    <td>
                        @if (ViewBag.FilterByGroup)
                        {
                            <button class="btn btn-danger" onclick="removeFromGroup(@item.AutoId)">刪除</button>
                        }
                        else
                        {
                            <input type="checkbox" class="employee-checkbox" data-emp-id="@item.AutoId" />
                        }
                    </td>
                }
                <td>@item.EmpName</td>
                <td>@item.Department</td>
                <td>@item.Position</td>
                <td>@item.EmpNumber</td>
                <td>@item.SalesDepID</td>
                @if (!(ViewBag.IsEditing || ViewBag.FilterByGroup))
                {
                    <td>
                        <a href="@Url.Action("Edit", "RCS_EMPLOYEES", new { id = item.AutoId })" class="btn btn-info">編輯</a>
                        <a href="@Url.Action("Delete", "RCS_EMPLOYEES", new { id = item.AutoId })" class="btn btn-danger">刪除</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<div class="pagination-container" style="text-align:center; margin-top: 20px;">
    @Html.PagedListPager(Model, page => Url.Action("Index", new
    {
        page,
        search = Request.QueryString["search"],
        // 新增這行
        depFilter = Request.QueryString["depFilter"],

        pageSize = Request.QueryString["pageSize"],
        isEditing = Request.QueryString["isEditing"],
        selectedGroup = Request.QueryString["selectedGroup"],
        filterByGroup = Request.QueryString["filterByGroup"]
    }))
</div>


<script>
    document.addEventListener('DOMContentLoaded', function () {
    const searchButton = document.getElementById('searchButton');
    const isFilterByGroup = '@ViewBag.FilterByGroup' === 'True';
    const isEditing = '@ViewBag.IsEditing' === 'True'; // 從後端獲取編輯狀態
    const selectedGroup = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(ViewBag.SelectedGroup ?? ""))';// 從後端獲取選擇的組別名稱
    const exitSearchModeButton = document.getElementById('exitSearchModeButton');
    const editGroupButton = document.getElementById('editGroupButton');
    const SearchGroupButton = document.getElementById('SearchGroupButton');
    const selectAllButton = document.getElementById('selectAllButton');
    const deleteDailyGroupButton = document.getElementById('deleteDailyGroupButton');
    const depFilterSelect = document.getElementById('depFilter');

        if (depFilterSelect) {
            depFilterSelect.addEventListener('change', function () {
                const searchInput = document.querySelector('input[name="search"]').value;
                const depFilterValue = depFilterSelect.value;

                let url = '/RCS_EMPLOYEES/Index?search=' + encodeURIComponent(searchInput);

                // 帶上 depFilter 參數 (若有值)
                if (depFilterValue) {
                    url += `&depFilter=${encodeURIComponent(depFilterValue)}`;
                }

                // 若是編輯模式
                if (isEditing && selectedGroup) {
                    editGroupButton.style.display = 'none';
                    SearchGroupButton.style.display = 'none';
                    url += `&isEditing=true&selectedGroup=${encodeURIComponent(selectedGroup)}`;
                }

                // 若是查詢模式 (FilterByGroup)
                if (isFilterByGroup && selectedGroup) {
                    url += `&filterByGroup=true&selectedGroup=${encodeURIComponent(selectedGroup)}`;
                }
                window.location.href = url;
            });
        }




        if (searchButton) {
            // 綁定搜尋按鈕的點擊事件
            searchButton.addEventListener('click', function (event) {
                event.preventDefault();
                const searchInput = document.querySelector('input[name="search"]').value;
                let url = '/RCS_EMPLOYEES/Index?search=' + encodeURIComponent(searchInput);

                // 如果是編輯模式，保留組別參數
                if (isEditing && selectedGroup) {
                    editGroupButton.style.display = 'none';
                    SearchGroupButton.style.display = 'none';
                    url += `&isEditing=true&selectedGroup=${encodeURIComponent(selectedGroup)}`;
                }

                // 如果是查詢模式，保留查詢模式參數
                if (isFilterByGroup && selectedGroup) {
                    url += `&filterByGroup=true&selectedGroup=${encodeURIComponent(selectedGroup)}`;
                }

                // 重定向到後端
                window.location.href = url;
            });
        }


        if (isEditing) {
            const groupSelector = document.getElementById('groupSelector');
            const saveGroupSection = document.getElementById('saveGroupSection');
            document.getElementById('otherPageSection').style.display = 'none';  //進入編輯模式不顯示新增員工或返回會議記錄頁面按鈕
            deleteDailyGroupButton.style.display = 'none'; //隱藏刪除常用組別按鈕

            // 禁用組別選擇器
            groupSelector.disabled = true;

            // 隱藏編輯組別按鈕
            editGroupButton.style.display = 'none';
            SearchGroupButton.style.display = 'none';


            // 顯示保存分組區域
            saveGroupSection.style.display = 'block';

            // 恢復選擇的組別
            groupSelector.value = selectedGroup;
        }

    if (isFilterByGroup) {
        exitSearchModeButton.style.display = 'block'; // 顯示退出查詢模式按鈕
        document.getElementById('otherPageSection').style.display = 'none'; //進入編輯模式不顯示新增員工或返回會議記錄頁面按鈕
        deleteDailyGroupButton.style.display = 'none'; //隱藏刪除常用組別按鈕

        // 隱藏新增組別按鈕
        const addGroupButton = document.getElementById('addGroupButton');
        if (addGroupButton) {
            addGroupButton.style.display = 'none';
        }
    } else {
        exitSearchModeButton.style.display = 'none'; // 隱藏按鈕
    }
    const localStorageKey = 'groupEditingState';

    // 檢查是否為第一次進入
    const isFirstVisit = '@ViewBag.IsFirstVisit' === 'True';
    if (isFirstVisit) {
        localStorage.removeItem(localStorageKey); // 清除編輯狀態

    }

        let groupEditingState = JSON.parse(localStorage.getItem(localStorageKey)) || {
            selectedIds: [],
        };



    // 恢復組別選擇
    if (groupEditingState.selectedGroup) {
        const groupSelector = document.getElementById('groupSelector');
        if (groupSelector) {
            groupSelector.value = groupEditingState.selectedGroup;
        }
    }

    // 恢復編輯狀態和選中項目
    if (groupEditingState.isEditing) {
        document.querySelectorAll('.employee-checkbox').forEach(cb => {
            cb.style.display = 'inline-block';
            cb.disabled = false;

            const empId = cb.getAttribute('data-emp-id');
            if (groupEditingState.selectedIds.includes(empId)) {
                cb.checked = true;
            }
        });

        document.getElementById('saveGroupSection').style.display = 'block';
    }

    // 綁定選擇變更
    document.querySelectorAll('.employee-checkbox').forEach(cb => {
        cb.addEventListener('change', function () {
            const empId = cb.getAttribute('data-emp-id');
            if (cb.checked) {
                if (!groupEditingState.selectedIds.includes(empId)) {
                    groupEditingState.selectedIds.push(empId);
                }
            } else {
                groupEditingState.selectedIds = groupEditingState.selectedIds.filter(id => id !== empId);
            }

            // 更新 LocalStorage
            localStorage.setItem(localStorageKey, JSON.stringify(groupEditingState));
        });
    });

        // 點擊編輯分組
        window.editGroup = function () {
            const groupSelector = document.getElementById('groupSelector');
            const selectedGroup = groupSelector.value;

            if (!selectedGroup) {
                alert('請選擇組別！');
                return;
            }

            // 獲取當前查詢字串
            const urlParams = new URLSearchParams(window.location.search);

            // 確保分頁尺寸參數被保留
            const pageSize = urlParams.get('pageSize') || '10'; // 默認為 10
            urlParams.set('pageSize', pageSize);

            // 切換到編輯模式
            urlParams.set('isEditing', 'true');
            urlParams.set('selectedGroup', selectedGroup);

            // 更新 LocalStorage 的狀態
            groupEditingState.isEditing = true;
            groupEditingState.selectedGroup = selectedGroup;
            localStorage.setItem(localStorageKey, JSON.stringify(groupEditingState));
            localStorage.setItem('isEditMode', true);

            alert(`已切換到新增模式，請勾選員工並保存到組別「${selectedGroup}」！`);

            // 重定向到新的 URL
            window.location.search = urlParams.toString();
        };


        // 保存分組
        window.saveGroup = function () {
            const groupSelector = document.getElementById('groupSelector');
            const selectedGroup = groupSelector.value;

            if (!selectedGroup) {
                alert('請先選擇組別！');
                return;
            }

            if (groupEditingState.selectedIds.length === 0) {
                alert('請至少選擇一名員工！');
                return;
            }

            const url = '/RCS_EMPLOYEES/SaveGroup';
            const data = {
                groupName: selectedGroup,
                employeeIds: groupEditingState.selectedIds
            };

            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(data)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('保存成功！');

                        // 清空 LocalStorage
                        localStorage.removeItem(localStorageKey);

                        // 清空查詢字串並退出編輯模式
                        window.location.href = '/RCS_EMPLOYEES/Index'; // 重定向到主頁，清空查詢字串
                    } else {
                        alert(data.error || '保存失敗！');
                    }
                })
                .catch(error => {
                    console.error('保存組別失敗:', error);
                    alert('保存組別失敗，請稍後重試！');
                });
        };

        window.exitEditMode = function () {
            // 移除 LocalStorage 中的編輯狀態
            localStorage.removeItem(localStorageKey);

            // 恢復頁面到初始狀態
            const groupSelector = document.getElementById('groupSelector');
            groupSelector.disabled = false; // 組別下拉選單啟用
            groupSelector.value = ''; // 恢復為預設值

            document.querySelectorAll('.employee-checkbox').forEach(cb => {
                cb.style.display = 'none'; // 隱藏checkbox
                cb.checked = false; // 取消全部勾選
            });

            document.getElementById('saveGroupSection').style.display = 'none'; // 隱藏保存按鈕


            // 顯示“新增組別成員”按鈕
            const editGroupButton = document.getElementById('editGroupButton');
            editGroupButton.style.display = 'inline-block';

            // 清除查詢字串並刷新頁面
            const baseUrl = window.location.origin + window.location.pathname; // 獲取不帶查詢字串的 URL
            alert('已退出編輯組別模式！');
            window.location.href = baseUrl; // 重定向到清除查詢字串的 URL
        };
        window.exitSearchMode = function () {
            // 移除查詢模式狀態
            localStorage.removeItem('isFilterByGroup'); // 清除本地存儲中的查詢模式標記

            // 重置組別選擇器
            const groupSelector = document.getElementById('groupSelector');
            groupSelector.disabled = false; // 啟用組別選擇器
            groupSelector.value = ''; // 恢復到提示選項

            // 隱藏退出查詢模式按鈕
            const exitSearchModeButton = document.getElementById('exitSearchModeButton');
            exitSearchModeButton.style.display = 'none';

            // 清除查詢條件並重定向到不帶查詢參數的 URL
            const baseUrl = window.location.origin + window.location.pathname; // 獲取不帶查詢字串的基礎 URL
            alert('已退出查詢模式！');
            window.location.href = baseUrl; // 重新定向到清除查詢參數的 URL
        };
        // 定義全選功能
        window.selectAllCheckboxes = function () {
            const checkboxes = document.querySelectorAll('.employee-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = true; // 勾選所有 checkbox
                const empId = checkbox.getAttribute('data-emp-id');
                if (!groupEditingState.selectedIds.includes(empId)) {
                    groupEditingState.selectedIds.push(empId); // 添加到已選清單
                }
            });

            // 更新 LocalStorage
            localStorage.setItem(localStorageKey, JSON.stringify(groupEditingState));

        };

        // 定義取消全選功能（如需）
        window.clearAllSelection = function () {
            // 獲取所有當前頁面的 checkbox
            const checkboxes = document.querySelectorAll('.employee-checkbox');

            // 取消選取所有 checkbox
            checkboxes.forEach(checkbox => {
                checkbox.checked = false;

                // 從 groupEditingState 中移除未選的 ID
                const empId = checkbox.getAttribute('data-emp-id');
                const index = groupEditingState.selectedIds.indexOf(empId);
                if (index !== -1) {
                    groupEditingState.selectedIds.splice(index, 1);
                }
            });

            // 更新 LocalStorage
            localStorage.setItem(localStorageKey, JSON.stringify(groupEditingState));

        };

        // 在頁面加載時恢復勾選狀態
        const checkboxes = document.querySelectorAll('.employee-checkbox');
        checkboxes.forEach(checkbox => {
            const empId = checkbox.getAttribute('data-emp-id');
            if (groupEditingState.selectedIds.includes(empId)) {
                checkbox.checked = true; // 恢復已選中的 checkbox
            }
        });

        // 在切換 checkbox 時同步更新 groupEditingState
        checkboxes.forEach(checkbox => {
            checkbox.addEventListener('change', function () {
                const empId = checkbox.getAttribute('data-emp-id');
                if (checkbox.checked) {
                    if (!groupEditingState.selectedIds.includes(empId)) {
                        groupEditingState.selectedIds.push(empId); // 添加到已選清單
                    }
                } else {
                    groupEditingState.selectedIds = groupEditingState.selectedIds.filter(id => id !== empId);
                }

                // 更新 LocalStorage
                localStorage.setItem(localStorageKey, JSON.stringify(groupEditingState));
            });
        });
});

    function addGroup() {
    const url = '@Url.Action("AddGroup", "RCS_EMPLOYEES")';
    const groupName = document.getElementById("newGroupName").value.trim();

    if (!groupName) {
        alert("請輸入組別名稱！");
        return;
    }

    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        body: JSON.stringify({ groupName })
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message || '組別新增成功！');
                location.reload(); // 成功後刷新頁面
            } else {
                alert(data.error || '新增組別失敗！');
            }
        })
        .catch(error => {
            console.error('新增組別失敗:', error);
            alert('新增組別失敗，請稍後重試！');
        });
    }
    function filterByGroup() {
        const selectedGroup = document.getElementById('groupSelector').value;
        const exitSearchModeButton = document.getElementById('exitSearchModeButton');

        if (!selectedGroup) {
            alert('請選擇組別！');
            return;
        }

        exitSearchModeButton.style.display = 'block';

        // 獲取當前查詢字串
        const urlParams = new URLSearchParams(window.location.search);

        // 設置查詢模式參數
        urlParams.set('filterByGroup', 'true');
        urlParams.set('selectedGroup', selectedGroup);

        // 保留當前的分頁尺寸
        if (urlParams.has('pageSize')) {
            const pageSize = urlParams.get('pageSize');
            urlParams.set('pageSize', pageSize);
        } else {
            urlParams.set('pageSize', '10'); // 預設值
        }

        // 重新定向到新的 URL
        window.location.search = urlParams.toString();
    }
    function updatePageSize() {
        const pageSize = document.getElementById('pageSizeSelector').value;
        const urlParams = new URLSearchParams(window.location.search);

        urlParams.set('pageSize', pageSize);

        urlParams.set('page', '1');

        // 如果處於編輯模式，保留相關參數
        if (urlParams.has('isEditing') && urlParams.has('selectedGroup')) {
            urlParams.set('isEditing', 'true');
            const selectedGroup = urlParams.get('selectedGroup');
            urlParams.set('selectedGroup', selectedGroup);
        }

        // 如果處於查詢(分組篩選)模式，保留相關參數
        if (urlParams.has('filterByGroup') && urlParams.has('selectedGroup')) {
            urlParams.set('filterByGroup', 'true');
            const selectedGroup = urlParams.get('selectedGroup');
            urlParams.set('selectedGroup', selectedGroup);
        }

        // 保留 depFilter
        if (urlParams.has('depFilter')) {
            const depVal = urlParams.get('depFilter');
            urlParams.set('depFilter', depVal);
        }

        // 保留 search
        if (urlParams.has('search')) {
            const searchVal = urlParams.get('search');
            urlParams.set('search', searchVal);
        }

        // 若都不在編輯或查詢模式 => 刪掉 selectedGroup
        if (!urlParams.has('isEditing') && !urlParams.has('filterByGroup')) {
            urlParams.delete('selectedGroup');
        }

        window.location.search = urlParams.toString();
    }



    function removeFromGroup(empId) {
        const selectedGroup = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(ViewBag.SelectedGroup ?? ""))';


        if (!selectedGroup) {
            alert('無法移除，請先選擇組別！');
            return;
        }

        if (!confirm('確定要將該員工從組別中移除嗎？')) {
            return;
        }

        const url = `/RCS_EMPLOYEES/RemoveFromGroup`;
        const data = { groupName: selectedGroup, empId: empId };

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify(data)
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('已成功移除！');
                    location.reload(); // 刷新頁面
                } else {
                    alert(data.error || '移除失敗！');
                }
            })
            .catch(error => {
                console.error('移除失敗:', error);
                alert('移除失敗，請稍後重試！');
            });
    }
    function deleteDailyGroup() {
        const selector = document.getElementById('groupSelector');
        const selectedGroupName = selector.value;
        if (!selectedGroupName) {
            alert("請先選擇要刪除的常用組別！");
            return;
        }

        if (!confirm(`確定要刪除常用組別「${selectedGroupName}」嗎？`)) {
            return;
        }

        fetch('/RCS_EMPLOYEES/DeleteGroup', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ groupName: selectedGroupName })
        })
        .then(resp => resp.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert("刪除失敗: " + data.message);
            }
        })
        .catch(err => {
            alert("伺服器錯誤：" + err);
        });
    }
        function redirectToCreate() {
        // 使用 window.location.href 導向到 Create 頁面
        window.location.href = '@Url.Action("Create", "RCS_EMPLOYEES")';
    }
    function redirectToMeeting() {
    // 使用 window.location.href 導向到 Create 頁面
        window.location.href = '@Url.Action("Index", "RCS_MEETING")';

}
</script>




