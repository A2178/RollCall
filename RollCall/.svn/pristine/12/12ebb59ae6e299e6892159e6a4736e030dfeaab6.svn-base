@model RollCall.Models.MeetingViewModel

<title>沛華集團抽獎系統</title>

@using PagedList.Mvc
<link rel="stylesheet" href="~/Content/BackendStyle.css">

@using (Html.BeginForm("SearchOrCreate", "RCS_MEETING", FormMethod.Post, new { enctype = "multipart/form-data", id = "searchCreateForm" }))
{
    @Html.AntiForgeryToken()

    <div style="margin-top: 20px; display: flex; justify-content: center; align-items: center; padding: 12px;">
        <!-- 會議名稱輸入框 -->
        <div class="form-group text-center mr-4">
            @Html.Label("會議名稱", htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.NewMeeting.MEETING_NAME, new { htmlAttributes = new { @class = "form-control", @placeholder = "輸入會議名稱", @id = "meetingNameInput" } })
            @Html.ValidationMessageFor(model => model.NewMeeting.MEETING_NAME, "", new { @class = "text-danger" })
        </div>

        <!-- 開始時間輸入框 -->
        <div class="form-group text-center mr-4">
            @Html.Label("開始時間", htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.NewMeeting.MEETING_START, new { htmlAttributes = new { @class = "form-control", @type = "datetime-local", @id = "meetingStartInput" } })
            @Html.ValidationMessageFor(model => model.NewMeeting.MEETING_START, "", new { @class = "text-danger" })
        </div>

        <!-- 結束時間輸入框 -->
        <div class="form-group text-center mr-4">
            @Html.Label("結束時間", htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.NewMeeting.MEETING_END, new { htmlAttributes = new { @class = "form-control", @type = "datetime-local", @id = "meetingEndInput" } })
            @Html.ValidationMessageFor(model => model.NewMeeting.MEETING_END, "", new { @class = "text-danger" })
        </div>

        <!-- Excel 文件上傳 -->
        <div class="form-group text-center mr-4">
            <label class="btn btn-primary" style="height: 40px; line-height: 1.5; padding: 6px 12px; display: inline-block; vertical-align: middle; margin-right: 20px;">
                人員名單Excel
                <input type="file" id="ExcelFile" name="ExcelFile" accept=".xlsx, .xls" style="display: none;" />
            </label>
        </div>

        <!-- 搜尋與建立會議按鈕 -->
        <div class="form-group text-center">
            <button type="submit" name="action" value="create" class="btn btn-primary" style="height: 40px; line-height: 1.5; padding: 6px 12px; margin-right: 25px;" onclick="return validateMeetingForm()">建立會議</button>
            <button type="submit" name="action" value="search" class="btn btn-primary" style="height: 40px; line-height: 1.5; padding: 6px 12px;">搜尋會議</button>
        </div>
    </div>}

<!-- 會議紀錄表格 -->
<table class="table table-striped table-bordered text-center" style="margin-top: 20px;">
    <thead>
        <tr>
            <th>No.</th>
            <th>會議名稱</th>
            <th>開始時間</th>
            <th>結束時間</th>
            <th>人員名單下載</th>
            <th>會議連結</th>
            <th>抽籤記錄下載</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var meeting in Model.MeetingList)
        {
            <tr>
                <td>@meeting.AUTO_ID</td>
                <td>@meeting.MEETING_NAME</td>
                <td>@meeting.MEETING_START</td>
                <td>@meeting.MEETING_END</td>

                <!-- 人員名單下載按鈕 -->
                <td>
                    <a href="@Url.Action("DownloadMemberList", "RCS_MEETING", new { guid = meeting.AUTO_GUID })" class="btn btn-primary">
                        人員名單
                    </a>
                </td>

                <!-- 會議連結按鈕 -->
                <td>
                    <a href="@Url.Action("DownloadMeetingLink", "RCS_MEETING", new { guid = meeting.AUTO_GUID })" class="btn btn-primary">
                        下載連結
                    </a>
                </td>

                <!-- 抽籤記錄按鈕 -->
                <td>
                    <a href="@Url.Action("DownloadRaffleLog", "RCS_MEETING", new { meetingGuid = meeting.AUTO_GUID })" class="btn btn-primary">
                        抽籤紀錄
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- 分頁功能控制項 -->
<div class="pagination-container" style="text-align:center">
    @Html.PagedListPager(Model.MeetingList, page => Url.Action("Index", new { page }))
</div>

<!-- JavaScript: 設置DateTimePicker預設值和搜尋會議 -->
<script type="text/javascript">
    // 設置當天日期的0時0分作為開始時間的預設值
    window.onload = function () {
        var now = new Date();
        var year = now.getFullYear();
        var month = (now.getMonth() + 1).toString().padStart(2, '0'); // 月份從0開始，需要加1
        var day = now.getDate().toString().padStart(2, '0');

        // 設置00:00為預設時間
        var dateString = year + '-' + month + '-' + day + 'T00:00';

        // 設置開始時間的預設值
        document.getElementById('meetingStartInput').value = dateString;
    };

    // 驗證表單的會議名稱、Excel 文件和開始/結束時間是否為空
    function validateMeetingForm() {
        var meetingName = document.getElementById('meetingNameInput').value;
        var excelFile = document.getElementById('ExcelFile').value;
        var meetingStart = document.getElementById('meetingStartInput').value;
        var meetingEnd = document.getElementById('meetingEndInput').value;

        if (!meetingName.trim()) { // 如果會議名稱為空或只有空格
            alert('請輸入會議名稱');
            return false; // 阻止表單提交
        }

        if (!excelFile) { // 如果沒有上傳Excel文件
            alert('請上傳人員名單Excel文件');
            return false; // 阻止表單提交
        }

        if (!meetingStart) { // 如果沒有選擇開始時間
            alert('請選擇開始時間');
            return false; // 阻止表單提交
        }

        if (!meetingEnd) { // 如果沒有選擇結束時間
            alert('請選擇結束時間');
            return false; // 阻止表單提交
        }

        return true; // 允許表單提交
    }
</script>
