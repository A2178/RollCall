@model RollCall.Models.MeetingEditViewModel

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>

    .horizontal-item {
        font-size: 22px;
    }

    /* 固定表頭的樣式 */
    .table-fixed-header thead th {
        position: sticky;
        top: 0;
        background-color: #fff; /* 背景顏色防止內容與表頭重疊 */
        z-index: 2;
        box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.1); /* 添加陰影效果，讓表頭更加突出 */
    }

    .table-centered th, .table-centered td {
        text-align: center; /* 置中表格所有內容 */
        vertical-align: middle; /* 垂直置中 */
    }

    thead th {
        position: sticky;
        top: 0;
        background-color: white;
        z-index: 100;
        border: 2px solid #dee2e6; /* 確保有明顯的邊框 */
        padding: 10px; /* 避免內容過於靠近邊框 */
    }

    tbody td {
        border: 1px solid #dee2e6;
        padding: 10px; /* 增加內邊距，讓內容不至於過於貼近邊框 */
    }

    table {
        border-collapse: separate; /* 使用 separate 避免 border-collapse 影響 sticky */
        width: 100%;
        border-spacing: 0; /* 防止表格之間的空隙 */
    }
</style>

<h2>編輯會議記錄</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" style="margin-right:20px;">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.HiddenFor(model => model.Meeting.AUTO_ID)
        @Html.HiddenFor(model => model.Meeting.AUTO_GUID)

        <!-- 水平排列的輸入框 -->
        <div class="form-group horizontal-group" style="display: flex; justify-content: space-between; gap: 20px;">
            <!-- 會議名稱 -->
            <div class="horizontal-item" style="flex: 1;">
                <label for="MeetingName">會議名稱</label>
                @Html.EditorFor(model => model.Meeting.MEETING_NAME, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Meeting.MEETING_NAME, "", new { @class = "text-danger" })
            </div>

            <!-- 開始時間 -->
            <div class="horizontal-item" style="flex: 1;">
                <label for="MeetingStart">開始時間</label>
                <input type="text" id="meetingStartInput" class="form-control" name="Meeting.MEETING_START" value="@Model.Meeting.MEETING_START?.ToString(" yyyy-MM-dd HH:mm")" />
                @Html.ValidationMessageFor(model => model.Meeting.MEETING_START, "", new { @class = "text-danger" })
            </div>

            <!-- 結束時間 -->
            <div class="horizontal-item" style="flex: 1;">
                <label for="MeetingEnd">結束時間</label>
                <input type="text" id="meetingEndInput" class="form-control" name="Meeting.MEETING_END" value="@Model.Meeting.MEETING_END?.ToString(" yyyy-MM-dd HH:mm")" />
                @Html.ValidationMessageFor(model => model.Meeting.MEETING_END, "", new { @class = "text-danger" })
            </div>
        </div>

        <hr />

        <!-- 人員名單部分 -->
        <h3><strong>與會人員名單</strong></h3>

        <!-- 包含捲動功能的table -->
        <div style="max-height: 300px; overflow-y: auto;">
            @if (Model.Members != null && Model.Members.Any())
            {
                <table class="table table-bordered table-centered">
                    <thead>
                        <tr>
                            <th>成員名稱</th>
                            <th>組別名稱</th>
                            <th>動作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Members)
                        {
                            <tr>
                                <td>@member.MEMBER_NAME</td>
                                <td>@member.GROUP_NAME</td>
                                <td>
                                    <!-- 編輯按鈕將對應的成員名稱、組別名稱和 AUTO_ID 傳遞給 editMember 方法 -->
                                    <button type="button" class="btn btn-warning" onclick="editMember('@member.MEMBER_NAME', '@member.GROUP_NAME', '@member.AUTO_ID')">編輯</button>
                                    <button type="button" class="btn btn-danger" onclick="removeMember('@member.AUTO_ID')">刪除</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>目前沒有任何成員。</p>
            }
        </div>

        <!-- 新增成員的表單 -->
        <div class="form-group" style="padding: 10px;">
            <!-- 隱藏欄位來存儲當前正在編輯的成員ID -->
            <input type="hidden" id="editingMemberId" value="">

            <div style="display:flex;">
                <!-- 左邊唯讀的原始名稱和原始組別名稱 -->
                <div style="margin-left:53%; width:200px;">
                    <label for="originalMemberName">原始名稱</label>
                    <input type="text" id="originalMemberName" class="form-control" style="background-color:lightgray;" readonly />

                    <label for="originalGroupName" style="margin-top: 10px;">原始組別名稱</label>
                    <input type="text" id="originalGroupName" class="form-control" style="background-color: lightgray;" readonly />
                </div>

                <!-- 右邊可編輯的輸入框 -->
                <div style="margin-left: 50px; width: 200px;" offset-md-1">
                    <label for="newMemberName">新增/修改成員</label>
                    <input type="text" id="newMemberName" class="form-control" placeholder="輸入成員名稱" />

                    <label for="newGroupName" style="margin-top: 10px;">新增/修改成員分組</label>
                    <input type="text" id="newGroupName" class="form-control" placeholder="輸入分組名稱" />

                    <!-- 新增/修改按鈕位於右側下方 -->
                    <button type="button" class="btn btn-success" style="margin-top: 10px;" onclick="addOrUpdateMember()">新增/修改</button>
                </div>
            </div>

            <!-- 儲存會議按鈕 -->
            <div class="row" style="margin-top: 20px; margin-left: 76%;">
                <div class="col-md-5 offset-md-6">
                    <input type="submit" value="儲存會議" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            var meetingStart = '@(Model.Meeting.MEETING_START.HasValue ? Model.Meeting.MEETING_START.Value.ToString("yyyy-MM-dd HH:mm") : "")';
            var meetingEnd = '@(Model.Meeting.MEETING_END.HasValue ? Model.Meeting.MEETING_END.Value.ToString("yyyy-MM-dd HH:mm") : "")';

            flatpickr("#meetingStartInput", {
                enableTime: true,
                time_24hr: true,
                dateFormat: "Y-m-d H:i",
                defaultDate: meetingStart
            });

            flatpickr("#meetingEndInput", {
                enableTime: true,
                time_24hr: true,
                dateFormat: "Y-m-d H:i",
                defaultDate: meetingEnd
            });
        });

        function removeMember(memberId) {
            if (confirm("確定要刪除該成員嗎？")) {
                $.post('@Url.Action("RemoveMember", "RCS_MEETING")', { memberId: memberId }, function (data) {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert("刪除失敗");
                    }
                });
            }
        }
        function editMember(memberName, groupName, memberId) {
            // 將資料指派到唯讀的原始名稱和組別名稱的輸入框中
            $('#originalMemberName').val(memberName);
            $('#originalGroupName').val(groupName);

            // 將資料指派到可編輯的輸入框中
            $('#newMemberName').val(memberName);
            $('#newGroupName').val(groupName);

            // 指派正在編輯的成員ID到隱藏的輸入框
            $('#editingMemberId').val(memberId);
        }

        function addOrUpdateMember() {
            var memberName = $('#newMemberName').val();
            var groupName = $('#newGroupName').val();
            var editingMemberId = $('#editingMemberId').val(); // 取得編輯中的成員ID

            if (memberName) {
                $.ajax({
                    url: '@Url.Action("AddOrUpdateMember", "RCS_MEETING")',
                    type: 'POST',
                    data: {
                        meetingId: '@Model.Meeting.AUTO_ID',
                        memberName: memberName,
                        groupName: groupName,
                        editingMemberId: editingMemberId // 傳遞編輯中的成員ID
                    },
                    success: function (data) {
                        if (data.success) {
                            alert("新增/更改成員資料成功！");
                            location.reload(); // 操作成功後重新載入頁面
                        } else {
                            alert("操作失敗: " + data.message);
                        }
                    },
                    error: function () {
                        alert("操作發生錯誤");
                    }
                });
            } else {
                alert("請輸入成員名稱");
            }
        }
    </script>
}
