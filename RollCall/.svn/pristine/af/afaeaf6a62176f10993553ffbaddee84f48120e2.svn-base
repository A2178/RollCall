@model RollCall.Models.MeetingViewModel

@{
    // 提取 TempData 的值
    var searchMeetingStart = TempData["SearchMeetingStart"] != null ? TempData["SearchMeetingStart"].ToString() : String.Empty;
    var searchMeetingEnd = TempData["SearchMeetingEnd"] != null ? TempData["SearchMeetingEnd"].ToString() : String.Empty;
}


<title>沛華集團抽籤系統</title>

@using PagedList.Mvc
<link rel="stylesheet" href="~/Content/BackendStyle.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

@using (Html.BeginForm("SearchOrCreate", "RCS_MEETING", FormMethod.Post, new { enctype = "multipart/form-data", id = "searchCreateForm" }))
{
    @Html.AntiForgeryToken()
    <div style="margin-top: 20px; width: 100%; margin-left:62.75px;">
        <div style="display: flex; align-items: center;">
            <!-- 會議名稱輸入框 -->
            <div class="form-group" style="width:180px; text-align: left; margin-right:20px;">
                @Html.Label("會議名稱", htmlAttributes: new { @class = "control-label", @style = "text-align: left;" })
                @Html.EditorFor(model => model.NewMeeting.MEETING_NAME, new { htmlAttributes = new { @class = "form-control", @placeholder = "輸入會議名稱", @id = "meetingNameInput" } })
                @Html.ValidationMessageFor(model => model.NewMeeting.MEETING_NAME, "", new { @class = "text-danger" })
            </div>

            <!-- 開始時間輸入框 -->
            <div class="form-group" style="width: 180px; text-align: left; margin-left: 20px; margin-right: 20px; ">
                @Html.Label("開始時間", htmlAttributes: new { @class = "control-label", @style = "text-align: left;" })
                @Html.EditorFor(model => model.NewMeeting.MEETING_START, new { htmlAttributes = new { @class = "form-control", @id = "meetingStartInput" } })
                @Html.ValidationMessageFor(model => model.NewMeeting.MEETING_START, "", new { @class = "text-danger" })
            </div>

            <!-- 結束時間輸入框 -->
            <div class="form-group" style="width: 180px; text-align: left; margin-left: 20px; margin-right: 20px; ">
                @Html.Label("結束時間", htmlAttributes: new { @class = "control-label", @style = "text-align: left;" })
                @Html.EditorFor(model => model.NewMeeting.MEETING_END, new { htmlAttributes = new { @class = "form-control", @id = "meetingEndInput" } })
                @Html.ValidationMessageFor(model => model.NewMeeting.MEETING_END, "", new { @class = "text-danger" })
            </div>

            <!-- Excel 文件上傳 -->
            <div class="form-group" style="text-align: left; margin-top:40px; width:135px;">
                <label class="btn btn-success" style="height: 40px; line-height: 1.5; padding: 6px 12px; display: flex; align-items: center; justify-content: center; width:110px; margin-left:15px;">
                    人員名單Excel
                    <input type="file" id="ExcelFile" name="ExcelFile" accept=".xlsx, .xls" style="display: none;" onchange="displayFileName()" />
                </label>
                <!-- 用於顯示檔案名稱的 <div>，預設顯示 "尚未選擇任何檔案" -->
                <div id="fileNameDisplay" style="margin-top: 5px; text-align: left; font-size: 14px; color: #555; margin-left:10px;">尚未選擇任何檔案</div>
            </div>

            <!-- 搜尋與建立會議按鈕 -->
            <div class="form-group" style=" display: flex; gap: 10px; margin-top: 15px;">
                <button type="submit" name="action" value="create" class="btn btn-primary" style="height: 40px; line-height: 1.5; " onclick="return validateMeetingForm()">建立會議</button>
                <button type="submit" name="action" value="search" class="btn btn-info" style="height: 40px; line-height: 1.5; " onclick="searchMeeting()">搜尋會議</button>
            </div>
        </div>
    </div>}

<!-- 會議紀錄表格 -->
<div style="width: 100%;">
    <table class="table table-striped table-bordered text-center" style="margin-top: 20px; text-align: center; vertical-align: middle;">
        <thead>
            <tr>
                <th>No.</th>
                <th>會議名稱</th>
                <th>開始時間</th>
                <th>結束時間</th>
                <th>人員名單下載</th>
                <th>編輯會議記錄</th>
                <th>會議連結</th>
                <th>抽籤記錄下載</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var meeting in Model.MeetingList)
            {
            <tr>
                <td style="vertical-align: middle;">@meeting.AUTO_ID</td>
                <td style="vertical-align: middle;">@meeting.MEETING_NAME</td>

                <!-- 開始時間，以 24 小時制顯示 -->
                <td style="vertical-align: middle;">
                    @(meeting.MEETING_START.HasValue ? meeting.MEETING_START.Value.ToString("yyyy/MM/dd HH:mm:ss") : "")
                </td>

                <!-- 結束時間，以 24 小時制顯示 -->
                <td style="vertical-align: middle;">
                    @(meeting.MEETING_END.HasValue ? meeting.MEETING_END.Value.ToString("yyyy/MM/dd HH:mm:ss") : "")
                </td>

                <!-- 人員名單下載按鈕 -->
                <td style="vertical-align: middle;">
                    <a href="@Url.Action("DownloadMemberList", "RCS_MEETING", new { guid = meeting.AUTO_GUID })" class="btn btn-success">
                        人員名單
                    </a>
                </td>

                <!-- 人員名單下載按鈕 -->
                <td style="vertical-align: middle;">
                    <a href="@Url.Action("DownloadMemberList", "RCS_MEETING", new { guid = meeting.AUTO_GUID })" class="btn btn-danger">
                        編輯會議記錄
                    </a>
                </td>

                <!-- 會議連結按鈕 -->
                <td style="vertical-align: middle;">
                    <a href="@Url.Action("DownloadMeetingLink", "RCS_MEETING", new { guid = meeting.AUTO_GUID })" class="btn btn-primary">
                        下載連結
                    </a>
                </td>

                <!-- 抽籤記錄按鈕 -->
                <td style="vertical-align: middle;">
                    <a href="@Url.Action("DownloadRaffleLog", "RCS_MEETING", new { meetingGuid = meeting.AUTO_GUID })" class="btn btn-success">
                        抽籤紀錄
                    </a>
                </td>
            </tr>
            }
        </tbody>

    </table>
</div>

<!-- 分頁功能控制項 -->
<div class="pagination-container" style="text-align:center">
    @Html.PagedListPager(Model.MeetingList, page => Url.Action("Index", new { page }))
</div>

<script type="text/javascript">
    // 設置當天日期的0時0分作為開始時間的預設值
    document.addEventListener('DOMContentLoaded', function () {
    // 初始化 Flatpickr 並設置預設日期
    var tempMeetingStart = '@TempData["SearchMeetingStart"]' || '';
    var tempMeetingEnd = '@TempData["SearchMeetingEnd"]' || '';

    flatpickr("#meetingStartInput", {
        enableTime: true,
        time_24hr: true,
        dateFormat: "Y-m-d H:i",
        defaultDate: tempMeetingStart || new Date().toISOString().slice(0, 16) // 默認為今天0時0分
    });

    flatpickr("#meetingEndInput", {
        enableTime: true,
        time_24hr: true,
        dateFormat: "Y-m-d H:i",
        defaultDate: tempMeetingEnd || '' // 如果 TempData 沒有值，則保持空白
    });

    // 確保 Flatpickr 正常加載後，處理自動搜尋
    if (!sessionStorage.getItem('hasSearched')) {
        document.querySelector("button[name='action'][value='search']").click();
        sessionStorage.setItem('hasSearched', 'true');
    }
});


    function searchMeeting() {
    var meetingName = document.getElementById('NewMeeting_MEETING_NAME').value; // 會議名稱的輸入框
    var meetingStart = document.getElementById('meetingStartInput').value; // 取得 DateTimePicker 的值
    var meetingEnd = document.getElementById('meetingEndInput').value; // 取得 DateTimePicker 的值

    if (meetingName) {
        window.location.href = '@Url.Action("Index", "RCS_MEETING")' +
            '?search=' + encodeURIComponent(meetingName) +
            '&searchStart=' + encodeURIComponent(meetingStart) +
            '&searchEnd=' + encodeURIComponent(meetingEnd);
    } else {
        alert('請輸入會議名稱進行搜尋');
    }
}

    // 防呆，建立會議資訊時，驗證會議名稱、開始與結束時間是否為空及是否已經上傳人員名單
    function validateMeetingForm() {
        var meetingName = document.getElementById('meetingNameInput').value;
        var excelFile = document.getElementById('ExcelFile').value;
        var meetingStart = document.getElementById('meetingStartInput').value;
        var meetingEnd = document.getElementById('meetingEndInput').value;

        if (!meetingName.trim()) { // 如果會議名稱為空或只有空格
            alert('請輸入會議名稱');
            return false;
        }

        if (!excelFile) { // 如果沒有上傳Excel文件
            alert('請上傳人員名單Excel文件');
            return false;
        }

        if (!meetingStart) { // 如果沒有選擇開始時間
            alert('請選擇開始時間');
            return false;
        }

        if (!meetingEnd) { // 如果沒有選擇結束時間
            alert('請選擇結束時間');
            return false;
        }
        return true;
    }
    function displayFileName() {
        var fileInput = document.getElementById('ExcelFile');
        var fileNameDisplay = document.getElementById('fileNameDisplay');

        if (fileInput.files.length > 0) {
            // 如果有上傳人員名單，顯示檔案名稱
            fileNameDisplay.textContent = fileInput.files[0].name;
        } else {
            // 如果沒有上傳人員名單
            fileNameDisplay.textContent = '尚未選擇任何檔案';
        }
    }
</script>
