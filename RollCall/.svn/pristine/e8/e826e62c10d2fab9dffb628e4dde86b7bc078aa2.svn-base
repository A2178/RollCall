@model RollCall.Models.RCS_MEETING

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit Meeting</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- 隱藏 AUTO_ID，用於識別會議 -->
        @Html.HiddenFor(model => model.AUTO_ID)
        @Html.HiddenFor(model => model.AUTO_GUID) <!-- 隱藏 AUTO_GUID -->
        <!-- 會議名稱輸入框 -->
        <div class="form-group">
            @Html.LabelFor(model => model.MEETING_NAME, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MEETING_NAME, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.MEETING_NAME, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- 開始時間輸入框 -->
        <div class="form-group">
            @Html.LabelFor(model => model.MEETING_START, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MEETING_START, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.MEETING_START, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- 結束時間輸入框 -->
        <div class="form-group">
            @Html.LabelFor(model => model.MEETING_END, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MEETING_END, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.MEETING_END, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
