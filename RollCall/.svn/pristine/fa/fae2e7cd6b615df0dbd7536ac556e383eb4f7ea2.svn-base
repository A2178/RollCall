using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Entity;
using System.Linq;
using System.Net;
using System.Web;
using System.Web.Mvc;
using OfficeOpenXml;
using PagedList;
using RollCall.Models;
using ClosedXML.Excel;
using System.IO;
using Serilog;
using RollCall.Filters;

namespace RollCall.Controllers
{
    public class RCS_EMPLOYEESController : Controller
    {
        private TEST_RollCallDBEntities db = new TEST_RollCallDBEntities();

        [AuthorizeFilter]
        public ActionResult Index(
    string search,
    string depFilter,  // 新增的參數
    int? page,
    int? pageSize,
    bool? isEditing,
    string selectedGroup,
    bool? filterByGroup)
        {
            // 根據 Session["Permission"] 限制員工資料的篩選
            string permission = Session["Permission"]?.ToString();
            Log.Information("進入員工資料表, 使用者權限: {permission}, 搜尋: {search}, 部門篩選: {depFilter}, 分頁: {page}, 尺寸: {pageSize}, 是否編輯: {isEditing}, 選組: {selectedGroup}, 過濾: {filterByGroup}",
                permission, search, depFilter, page, pageSize, isEditing, selectedGroup, filterByGroup);

            string lastGroup = Session["LastSelectedGroup"] as string;
            if (!string.IsNullOrEmpty(selectedGroup) && selectedGroup != lastGroup)
            {
                page = 1;
            }
            Session["LastSelectedGroup"] = selectedGroup;

            bool isFirstVisit = string.IsNullOrEmpty(Request.Headers["Referer"]);
            int size = pageSize ?? 10;

            // 查詢所有在職員工
            IQueryable<EmployeeViewModel> employees = db.RCS_EMPLOYEES
                .Where(e => e.IS_ACTIVED && !e.IS_DELETED)
                .Select(e => new EmployeeViewModel
                {
                    AutoId = e.AUTO_ID,
                    EmpName = e.EMP_NAME,
                    Department = e.DEPARTMENT,
                    Position = e.POSITION,
                    EmpNumber = e.EMP_NUMBER,
                    SalesDepID = e.SALES_DEP_ID
                });

            // Session 值初始化
            Session["filterByGroup"] = false;
            Session["isEditing"] = false;

            // 根據使用者權限篩選 (舊邏輯)
            if (!string.IsNullOrEmpty(permission))
            {
                switch (permission)
                {
                    case "台北HR":
                        employees = employees.Where(e => e.SalesDepID == "PS.TPE" || e.SalesDepID == "PC.TPE" || e.SalesDepID == "總經理");
                        break;
                    case "台中HR":
                        employees = employees.Where(e => e.SalesDepID == "PS.TXG" || e.SalesDepID == "PC.TXG" || e.SalesDepID == "總經理");
                        break;
                    case "高雄HR":
                        employees = employees.Where(e => e.SalesDepID == "PS.KHH" || e.SalesDepID == "PC.KHH" || e.SalesDepID == "總經理");
                        break;
                    default:
                        break;
                }
            }

            // 如果啟用了分組篩選 (舊邏輯)
            if (filterByGroup == true && !string.IsNullOrEmpty(selectedGroup))
            {
                Session["filterByGroup"] = true;
                var groupMemberIds = db.RCS_EMPLOYEE_GROUP
                    .Where(g => g.GROUP_AUTO_ID ==
                        db.RCS_GROUP
                          .Where(gr => gr.GROUP_NAME == selectedGroup && gr.IS_ACTIVED && !gr.IS_DELETED)
                          .Select(gr => gr.AUTO_ID)
                          .FirstOrDefault()
                        && g.IS_ACTIVED
                        && !g.IS_DELETED)
                    .Select(g => g.EMP_AUTO_ID)
                    .ToList();

                employees = employees.Where(e => groupMemberIds.Contains(e.AutoId));
            }

            // 如果進入編輯模式 (舊邏輯)
            if (isEditing == true && !string.IsNullOrEmpty(selectedGroup))
            {
                Session["isEditing"] = true;
                var groupMemberIds = db.RCS_EMPLOYEE_GROUP
                    .Where(g => g.GROUP_AUTO_ID ==
                        db.RCS_GROUP
                          .Where(gr => gr.GROUP_NAME == selectedGroup && gr.IS_ACTIVED && !gr.IS_DELETED)
                          .Select(gr => gr.AUTO_ID)
                          .FirstOrDefault()
                        && g.IS_ACTIVED
                        && !g.IS_DELETED)
                    .Select(g => g.EMP_AUTO_ID)
                    .ToList();

                employees = employees.Where(e => !groupMemberIds.Contains(e.AutoId));
            }

            // 搜尋條件過濾 (舊邏輯)
            if (!string.IsNullOrEmpty(search))
            {
                employees = employees.Where(e =>
                    e.EmpName.Contains(search) ||
                    e.Department.Contains(search) ||
                    e.EmpNumber.Contains(search) ||
                    e.Position.Contains(search) ||
                    e.SalesDepID.Contains(search));
            }

            // **部門下拉篩選** => depFilter = "PS" 或 "PC" 或 ""
            // 若 depFilter = "PS"，就篩出 SalesDepID 以 "PS" 開頭的員工
            // 若 depFilter = "PC"，就篩出 SalesDepID 以 "PC" 開頭的員工
            // 若空 => 不篩
            if (!string.IsNullOrEmpty(depFilter))
            {
                // 假設需求是 "PS" => e.SalesDepID.StartsWith("PS")
                //                "PC" => e.SalesDepID.StartsWith("PC")
                //                其他值則可不篩 or 你可擴充

                if (depFilter == "PS")
                {
                    employees = employees.Where(e => e.SalesDepID.StartsWith("PS"));
                }
                else if (depFilter == "PC")
                {
                    employees = employees.Where(e => e.SalesDepID.StartsWith("PC"));
                }
            }

            // 查詢所有可用的自定義分組 (舊邏輯)
            IQueryable<RCS_GROUP> groupsQuery = db.RCS_GROUP
                .Where(g => g.IS_ACTIVED && !g.IS_DELETED);

            if (!string.IsNullOrEmpty(permission))
            {
                groupsQuery = groupsQuery.Where(g => g.CREATE_BY == permission);
            }
            var groups = groupsQuery.Select(g => g.GROUP_NAME).ToList();

            // 傳遞每頁顯示筆數到 ViewBag
            ViewBag.PageSize = size;
            ViewBag.Groups = groups;

            // 保持查詢字串的 isEditing 狀態
            ViewBag.IsEditing = isEditing ?? false;
            // 傳遞當前選擇的組別到 View
            ViewBag.SelectedGroup = selectedGroup ?? "";
            // 傳遞是否啟用分組篩選
            ViewBag.FilterByGroup = filterByGroup ?? false;
            // 傳遞是否為首次訪問
            ViewBag.IsFirstVisit = isFirstVisit;

            Log.Information("進入員工資料表結束, 使用者權限: {permission}, 搜尋: {search}, 部門篩選: {depFilter}, 分頁: {page}, 尺寸: {pageSize}, 是否編輯: {isEditing}, 選組: {selectedGroup}, 過濾: {filterByGroup}",
                permission, search, depFilter, page, pageSize, isEditing, selectedGroup, filterByGroup);

            return View(employees.OrderBy(e => e.EmpName).ToPagedList(page ?? 1, size));
        }




        [AuthorizeFilter]
        public ActionResult Create()
        {
            // 模擬從數據庫中獲取職務下拉選單的數據
            var positions = db.RCS_EMPLOYEES
                .Select(e => e.POSITION)
                .Distinct()
                .ToList();

            ViewBag.Positions = new SelectList(positions);

            return View(new EmployeeViewModel());
        }

        [HttpPost]
        [AuthorizeFilter]
        public JsonResult Create(EmployeeViewModel model)
        {
            string permission = Session["Permission"]?.ToString();
            Log.Information("建立員工資料, 使用者權限: {permission}", permission);
            if (ModelState.IsValid)
            {
                try
                {
                    if (db.RCS_EMPLOYEES.Any(e => e.EMP_NUMBER == model.EmpNumber))
                    {
                        Log.Error("建立員工資料錯誤！, 使用者權限: {permission}, 員工資料: {model}", permission,model);
                        return Json(new { success = false, error = "員工編號已存在！" });
                    }

                    var newEmployee = new RCS_EMPLOYEES
                    {
                        AUTO_GUID = Guid.NewGuid(),
                        EMP_NAME = model.EmpName,
                        DEPARTMENT = model.Department,
                        POSITION = model.Position,
                        EMP_NUMBER = model.EmpNumber,
                        SALES_DEP_ID = model.SalesDepID,
                        IS_ACTIVED = true,
                        IS_DELETED = false,
                        CREATE_BY = Session["Permission"]?.ToString() ?? "System",
                        CREATE_TIME = DateTime.Now,
                        MODIFY_BY = Session["Permission"]?.ToString() ?? "System",
                        MODIFY_TIME = DateTime.Now
                    };

                    db.RCS_EMPLOYEES.Add(newEmployee);
                    db.SaveChanges();

                    Log.Information("建立員工資料結束, 使用者權限: {permission}, 姓名: {EMP_NAME}, 部門: {DEPARTMENT}, 職位: {POSITION}, 員編:{EMP_NUMBER}, 業屬: {SALES_DEP_ID}", 
                        permission,newEmployee.EMP_NAME, newEmployee.DEPARTMENT,newEmployee.POSITION,newEmployee.EMP_NUMBER,newEmployee.SALES_DEP_ID);

                    return Json(new { success = true });
                }
                catch (Exception ex)
                {
                    Log.Error("建立員工資料錯誤！, 使用者權限: {permission}, 員工資料:{model}", permission, model);
                    return Json(new { success = false, error = $"新增失敗：{ex.Message}" });
                }
            }
            Log.Error("建立員工資料錯誤！, 使用者權限: {permission}, 員工資料: {model}", permission, model);
            return Json(new { success = false, error = "請檢查輸入內容！" });
        }



        [HttpGet]
        [AuthorizeFilter]
        public ActionResult UploadEmployeeList()
        {
            return View();
        }

        [HttpPost]
        public ActionResult UploadEmployeeList(HttpPostedFileBase file)
        {
            if (file == null || file.ContentLength == 0)
            {
                TempData["Error"] = "請選擇有效的 Excel 檔案";
                return RedirectToAction("Index");
            }

            try
            {
                int importCount = 0; // 成功匯入的資料筆數
                using (var workbook = new XLWorkbook(file.InputStream))
                {
                    if (workbook.Worksheets.Count == 0)
                    {
                        throw new Exception("Excel 文件中沒有任何有效的工作表。");
                    }

                    var worksheet = workbook.Worksheets.First();
                    if (worksheet == null)
                    {
                        throw new Exception("找不到工作表，請確認檔案內容。");
                    }

                    // 獲取行數與列數
                    var rowCount = worksheet.RowsUsed().Count();
                    var headerRow = worksheet.Row(1);

                    // 確認表頭並建立欄位映射
                    Dictionary<string, int> headerMap = new Dictionary<string, int>();
                    foreach (var cell in headerRow.CellsUsed())
                    {
                        string header = cell.GetValue<string>().Trim();
                        if (!string.IsNullOrEmpty(header))
                        {
                            headerMap[header] = cell.Address.ColumnNumber;
                        }
                    }

                    // 必要欄位檢查
                    string[] requiredHeaders = new[] { "姓名", "部門", "職位", "員工編號", "分部" };
                    foreach (string header in requiredHeaders)
                    {
                        if (!headerMap.ContainsKey(header))
                        {
                            throw new Exception($"缺少必要的欄位：{header}");
                        }
                    }

                    // 分部代號映射 (SALES_DEP_ID)
                    Dictionary<string, string> departmentMapping = new Dictionary<string, string>
                    {
                        { "台北沛華", "PS.TPE" },
                        { "台北沛榮", "PC.TPE" },
                        { "台中沛華", "PS.TXG" },
                        { "台中沛榮", "PC.TXG" },
                        { "高雄沛華", "PS.KHH" },
                        { "高雄沛榮", "PC.KHH" },
                        { "台北沛驊", "PS.TPE" },
                        { "台中沛驊", "PS.TXG" },
                        { "高雄沛驊", "PS.KHH" },
                    };

                    // 逐行處理 Excel 資料
                    for (int row = 2; row <= rowCount; row++)
                    {
                        string empName = worksheet.Row(row).Cell(headerMap["姓名"]).GetValue<string>().Trim();
                        string department = worksheet.Row(row).Cell(headerMap["部門"]).GetValue<string>().Trim();
                        string position = worksheet.Row(row).Cell(headerMap["職位"]).GetValue<string>().Trim();
                        string empNumber = worksheet.Row(row).Cell(headerMap["員工編號"]).GetValue<string>().Trim();
                        string division = worksheet.Row(row).Cell(headerMap["分部"]).GetValue<string>().Trim();

                        if (string.IsNullOrEmpty(empName) || string.IsNullOrEmpty(empNumber))
                        {
                            continue; // 跳過資料不完整的行
                        }

                        // 檢查是否存在重複的員工編號
                        bool exists = db.RCS_EMPLOYEES.Any(e => e.EMP_NUMBER == empNumber);
                        if (exists)
                        {
                            continue; // 跳過重複的資料
                        }

                        // 根據分部映射 SALES_DEP_ID
                        string salesDepId = departmentMapping
                            .FirstOrDefault(m => division.Contains(m.Key)).Value ?? "總經理";

                        // 建立新的員工記錄
                        var employee = new RCS_EMPLOYEES
                        {
                            AUTO_GUID = Guid.NewGuid(),
                            EMP_NAME = empName,
                            DEPARTMENT = department,
                            POSITION = position,
                            EMP_NUMBER = empNumber,
                            SALES_DEP_ID = salesDepId,
                            IS_ACTIVED = true,
                            CREATE_BY = Session["Permission"]?.ToString() ?? "System",
                            CREATE_TIME = DateTime.Now,
                            MODIFY_BY = Session["Permission"]?.ToString() ?? "System",
                            MODIFY_TIME = DateTime.Now
                        };

                        db.RCS_EMPLOYEES.Add(employee);
                        importCount++;
                    }

                    db.SaveChanges();
                }

                TempData["Success"] = $"成功匯入 {importCount} 筆員工資料！";
            }
            catch (Exception ex)
            {
                TempData["Error"] = $"匯入失敗: {ex.Message}";
            }

            return RedirectToAction("Index");
        }

        [HttpPost]
        public JsonResult AddGroup(string groupName)
        {
            string permission = Session["Permission"]?.ToString() ?? "System";
            Log.Information("新增或重啟常用組別, 使用者權限: {permission}, 組別名稱: {groupName}",
                permission, groupName);

            try
            {
                if (string.IsNullOrEmpty(groupName))
                {
                    Log.Error("新增常用組別錯誤！名稱不可為空 =>  使用者權限: {permission}, 組別名稱: {groupName}",
                              permission, groupName);
                    return Json(new { success = false, error = "分組名稱不可為空！" });
                }

                // 檢查 RCS_GROUP 是否已存在 (不管IS_DELETED狀態)
                var existingGroup = db.RCS_GROUP
                    .FirstOrDefault(g => g.GROUP_NAME == groupName);

                if (existingGroup != null)
                {
                    // 若存在且 IS_DELETED = false，代表已經有啟用中的同名分組 -> 報錯
                    if (!existingGroup.IS_DELETED)
                    {
                        Log.Error("新增常用組別錯誤，該分組名稱已存在 =>  使用者權限: {permission}, 組別名稱: {groupName}",
                                  permission, groupName);
                        return Json(new { success = false, error = "該分組名稱已存在！" });
                    }
                    else
                    {
                        // 存在但被標記刪除 => 重啟 這個常用組別
                        Log.Information("發現同名分組被標記刪除, 準備重啟 =>  使用者權限: {permission}, 組別名稱: {groupName}",
                                        permission, groupName);

                        // 重啟 RCS_GROUP
                        existingGroup.IS_DELETED = false;
                        existingGroup.MODIFY_BY = permission;
                        existingGroup.MODIFY_TIME = DateTime.Now;
                        existingGroup.IS_ACTIVED = true; // 如需要

                        // 重啟該組別在 RCS_EMPLOYEE_GROUP
                        var employeeGroups = db.RCS_EMPLOYEE_GROUP
                            .Where(eg => eg.GROUP_AUTO_ID == existingGroup.AUTO_ID && eg.IS_DELETED)
                            .ToList();
                        foreach (var eg in employeeGroups)
                        {
                            eg.IS_DELETED = false;
                            eg.MODIFY_BY = permission;
                            eg.MODIFY_TIME = DateTime.Now;
                        }

                        // 收集此日常組別底下的所有員工ID (後續重啟 RCS_MEMBER 時用)
                        var employeeIdsOfThisGroup = employeeGroups
                            .Select(eg => eg.EMP_AUTO_ID)
                            .Distinct()
                            .ToList();

                        // 重啟該組別在 RCS_MEETING_GROUP_MAP
                        var mgMaps = db.RCS_MEETING_GROUP_MAP
                            .Where(m => m.GROUP_AUTO_ID == existingGroup.AUTO_ID && m.IS_DELETED)
                            .ToList();
                        foreach (var map in mgMaps)
                        {
                            map.IS_DELETED = false;
                            map.MODIFY_BY = permission;
                            map.MODIFY_TIME = DateTime.Now;
                        }

                        // 找出這個日常組別對應到的 meetingGroupIds
                        var meetingGroupIds = mgMaps
                            .Select(m => m.MEETING_GROUP_AUTO_ID)
                            .Distinct()
                            .ToList();

                        // 重啟「尚未開始」會議中的 RCS_MEMBER，但只針對此日常組別的員工
                        // 避免把同一會議組別裡，屬於其他日常組別的員工也誤重啟
                        if (meetingGroupIds.Any() && employeeIdsOfThisGroup.Any())
                        {
                            DateTime now = DateTime.Now;

                            var membersToReEnable = (
                                from mem in db.RCS_MEMBER
                                join mg in db.RCS_MEETING_GROUP on mem.MEETING_GROUP_AUTO_ID equals mg.AUTO_ID
                                join mt in db.RCS_MEETING on mg.MEETING_AUTO_ID equals mt.AUTO_ID
                                where meetingGroupIds.Contains(mg.AUTO_ID)
                                      && employeeIdsOfThisGroup.Contains((long)mem.EMP_AUTO_ID) // 只重啟屬於此日常組別的員工
                                      && mem.IS_DELETED
                                      && !mt.IS_DELETED
                                      && mt.MEETING_START > now
                                select mem
                            ).ToList();

                            foreach (var mem in membersToReEnable)
                            {
                                mem.IS_DELETED = false;
                                mem.MODIFY_BY = permission;
                                mem.MODIFY_TIME = DateTime.Now;
                            }
                        }

                        db.SaveChanges();
                        Log.Information("重啟常用組別成功 => 使用者權限: {permission}, 組別名稱: {groupName}",
                                        permission, groupName);
                        return Json(new { success = true, message = "已重啟先前被刪除的分組！" });
                    }
                }
                else
                {
                    // 該常用組別不存在於資料庫 => 新增常用組別
                    var newGroup = new RCS_GROUP
                    {
                        AUTO_GUID = Guid.NewGuid(),
                        GROUP_NAME = groupName,
                        IS_ACTIVED = true,
                        IS_DELETED = false,
                        CREATE_BY = permission,
                        CREATE_TIME = DateTime.Now,
                        MODIFY_BY = permission,
                        MODIFY_TIME = DateTime.Now
                    };

                    db.RCS_GROUP.Add(newGroup);
                    db.SaveChanges();

                    Log.Information("新增常用組別完成 => 使用者權限: {permission}, 組別名稱: {groupName}",
                                    permission, groupName);
                    return Json(new { success = true, message = "分組新增成功！" });
                }
            }
            catch (Exception ex)
            {
                Log.Error("新增(或重啟)常用組別發生錯誤 => 使用者權限: {permission}, 組別名稱: {groupName}, 錯誤訊息: {errMsg}",
                          permission, groupName, ex.Message);
                return Json(new { success = false, error = $"新增分組時發生錯誤：{ex.Message}" });
            }
        }



        [HttpPost]
        public ActionResult DeleteGroup(string groupName)
        {
            string currentUser = Session["Permission"]?.ToString() ?? "System";
            Log.Information("刪除常用組別, 使用者權限: {user}, 常用組別名稱: {groupName}", currentUser, groupName);

            // 找到日常組別 (RCS_GROUP) by groupName
            var dailyGroup = db.RCS_GROUP
                .FirstOrDefault(g => g.GROUP_NAME == groupName && !g.IS_DELETED);
            if (dailyGroup == null)
            {
                Log.Error("常用組別刪除失敗，找不到組別 => user={user}, 常用組別名稱: {groupName}", currentUser, groupName);
                return Json(new { success = false, message = "找不到常用組別" });
            }

            // 先標記此日常組別為刪除
            dailyGroup.IS_DELETED = true;
            dailyGroup.MODIFY_BY = currentUser;
            dailyGroup.MODIFY_TIME = DateTime.Now;

            // 找到在 RCS_EMPLOYEE_GROUP 中屬於此日常組別的對應，標記刪除
            var employeeGroups = db.RCS_EMPLOYEE_GROUP
                .Where(eg => eg.GROUP_AUTO_ID == dailyGroup.AUTO_ID && !eg.IS_DELETED)
                .ToList();
            foreach (var eg in employeeGroups)
            {
                eg.IS_DELETED = true;
                eg.MODIFY_BY = currentUser;
                eg.MODIFY_TIME = DateTime.Now;
            }

            // 找到此日常組別的所有員工ID (後面刪除 RCS_MEMBER 時要用)
            var employeeIdsOfThisGroup = employeeGroups
                .Select(eg => eg.EMP_AUTO_ID)
                .Distinct()
                .ToList();

            // 找到此日常組別 與 會議用組別 的對應 (RCS_MEETING_GROUP_MAP)，標記刪除
            var mgMaps = db.RCS_MEETING_GROUP_MAP
                .Where(map => map.GROUP_AUTO_ID == dailyGroup.AUTO_ID && !map.IS_DELETED)
                .ToList();
            foreach (var mgm in mgMaps)
            {
                mgm.IS_DELETED = true;
                mgm.MODIFY_BY = currentUser;
                mgm.MODIFY_TIME = DateTime.Now;
            }

            // 從 mgMaps 中擷取出「本日常組別對應的會議用組別ID」集合
            var meetingGroupIds = mgMaps
                .Select(m => m.MEETING_GROUP_AUTO_ID)
                .Distinct()
                .ToList();

            if (meetingGroupIds.Any() && employeeIdsOfThisGroup.Any())
            {
                // 在 RCS_MEMBER 中，只刪除「屬於這個日常組別的員工」+「該會議組別」的紀錄
                // 而非整個會議組別所有成員。再加上「會議尚未開始」條件
                DateTime now = DateTime.Now;

                var membersToDelete = (
                    from mem in db.RCS_MEMBER
                    join mg in db.RCS_MEETING_GROUP on mem.MEETING_GROUP_AUTO_ID equals mg.AUTO_ID
                    join mt in db.RCS_MEETING on mg.MEETING_AUTO_ID equals mt.AUTO_ID
                    where meetingGroupIds.Contains(mem.MEETING_GROUP_AUTO_ID)
                          && employeeIdsOfThisGroup.Contains(mem.EMP_AUTO_ID) // 只刪此群組員工
                          && !mem.IS_DELETED
                          && !mt.IS_DELETED
                          && mt.MEETING_START > now // 會議尚未開始
                    select mem
                ).ToList();

                // 標記這些 RCS_MEMBER 為刪除
                foreach (var member in membersToDelete)
                {
                    member.IS_DELETED = true;
                    member.MODIFY_BY = currentUser;
                    member.MODIFY_TIME = DateTime.Now;
                }
            }

            try
            {
                db.SaveChanges();
                Log.Information("常用組別刪除成功 => 使用者權限: {user}, 組別名稱: {groupName}", currentUser, groupName);
                return Json(new { success = true, message = $"常用組別「{groupName}」刪除完成" });
            }
            catch (Exception ex)
            {
                Log.Error("常用組別刪除失敗 => 使用者權限: {user}, 組別名稱: {groupName}, 錯誤訊息: {errMsg}",
                          currentUser, groupName, ex.Message);
                return Json(new { success = false, message = "刪除失敗：" + ex.Message });
            }
        }



        // 編輯組別成員
        [HttpPost]
        public JsonResult SaveGroup(string groupName, List<long> employeeIds)
        {
            string permission = Session["Permission"]?.ToString();
            Log.Information("保存組別, 使用者權限: {permission}, 組別名稱:{groupName}, 員工流水號: {employeeIds}",
                permission, groupName, employeeIds);

            if (string.IsNullOrEmpty(groupName) || employeeIds == null || !employeeIds.Any())
            {
                Log.Error("保存組別錯誤！, 使用者權限: {permission}, 組別名稱:{groupName}, 員工流水號: {employeeIds}",
                    permission, groupName, employeeIds);
                return Json(new { success = false, error = "組別名稱或員工清單無效！" });
            }

            try
            {
                // 找到常用群組 (RCS_GROUP)
                var group = db.RCS_GROUP
                    .FirstOrDefault(g => g.GROUP_NAME == groupName
                                         && g.IS_ACTIVED
                                         && !g.IS_DELETED);
                if (group == null)
                {
                    Log.Error("保存組別錯誤, 組別名稱: {groupName}, 員工流水號: {employeeIds}",
                        groupName, employeeIds);
                    return Json(new { success = false, error = "找不到指定的組別！" });
                }

                // 先處理 RCS_EMPLOYEE_GROUP (常用群組) - 指派員工
                var existingRecords = db.RCS_EMPLOYEE_GROUP
                    .Where(eg => eg.GROUP_AUTO_ID == group.AUTO_ID
                              && employeeIds.Contains(eg.EMP_AUTO_ID))
                    .ToList();

                foreach (var empId in employeeIds)
                {
                    var existingRecord = existingRecords
                        .FirstOrDefault(eg => eg.EMP_AUTO_ID == empId);

                    if (existingRecord != null)
                    {
                        // 如果記錄存在但被標記刪除，就重新啟用
                        if (existingRecord.IS_DELETED)
                        {
                            existingRecord.IS_DELETED = false;
                            existingRecord.MODIFY_BY = permission ?? "System";
                            existingRecord.MODIFY_TIME = DateTime.Now;
                        }
                    }
                    else
                    {
                        // 若不存在，直接新增
                        db.RCS_EMPLOYEE_GROUP.Add(new RCS_EMPLOYEE_GROUP
                        {
                            AUTO_GUID = Guid.NewGuid(),
                            GROUP_AUTO_ID = group.AUTO_ID,
                            EMP_AUTO_ID = empId,
                            IS_ACTIVED = true,
                            IS_DELETED = false,
                            CREATE_BY = permission ?? "System",
                            CREATE_TIME = DateTime.Now,
                            MODIFY_BY = permission ?? "System",
                            MODIFY_TIME = DateTime.Now
                        });
                    }
                }
                db.SaveChanges();

                // 同步更新到 RCS_MEMBER (會議群組)
                // 找出此常用群組對應到的所有會議組別ID
                var meetingGroupIds = db.RCS_MEETING_GROUP_MAP
                    .Where(map => map.GROUP_AUTO_ID == group.AUTO_ID && !map.IS_DELETED)
                    .Select(map => map.MEETING_GROUP_AUTO_ID)
                    .Distinct()
                    .ToList();

                if (meetingGroupIds.Any())
                {
                    // 先找「對應會議是否已結束」的資訊，
                    // 只允許對「尚未結束」的會議做「新增新員工」的動作
                    // =>  m.MEETING_END > DateTime.Now
                    var notEndedMeetingGroupIds = (
                        from mg in db.RCS_MEETING_GROUP
                        join mt in db.RCS_MEETING on mg.MEETING_AUTO_ID equals mt.AUTO_ID
                        where meetingGroupIds.Contains(mg.AUTO_ID)
                              && !mg.IS_DELETED
                              && !mt.IS_DELETED
                              && mt.MEETING_END > DateTime.Now
                        select mg.AUTO_ID
                    ).Distinct().ToList();

                    // 找到所有已存在於 RCS_MEMBER 的員工(無論IS_DELETED)
                    var existingMemberEmpIds = db.RCS_MEMBER
                        .Where(m => meetingGroupIds.Contains(m.MEETING_GROUP_AUTO_ID)
                                 && employeeIds.Contains(m.EMP_AUTO_ID))
                        .Select(m => m.EMP_AUTO_ID)
                        .Distinct()
                        .ToList();

                    // 只撈「IS_DELETED=true」的舊紀錄，準備重啟
                    var membersToReEnable = db.RCS_MEMBER
                        .Where(m => meetingGroupIds.Contains(m.MEETING_GROUP_AUTO_ID)
                                 && employeeIds.Contains(m.EMP_AUTO_ID)
                                 && m.IS_DELETED == true)
                        .ToList();

                    foreach (var mem in membersToReEnable)
                    {
                        // 不論會議是否已結束, 只要過去曾參與過, 皆可 "重啟"
                        mem.IS_DELETED = false;
                        mem.MODIFY_BY = permission ?? "System";
                        mem.MODIFY_TIME = DateTime.Now;
                    }
                    db.SaveChanges(); // 先存一次

                    //  算出那些 employeeIds 是「從未在 RCS_MEMBER 出現過」的
                    var neverHadMembers = employeeIds
                        .Except(existingMemberEmpIds) // -> 代表從未在該RCS_MEMBER出現
                        .ToList();

                    //  把 neverHadMembers 加入 RCS_MEMBER，但只限「尚未結束」的會議組別
                    //  (若是已結束的會議, 就跳過, 不新增)
                    if (neverHadMembers.Any() && notEndedMeetingGroupIds.Any())
                    {
                        foreach (var mgId in notEndedMeetingGroupIds)
                        {
                            foreach (var empId in neverHadMembers)
                            {
                                db.RCS_MEMBER.Add(new RCS_MEMBER
                                {
                                    AUTO_GUID = Guid.NewGuid(),
                                    MEETING_GROUP_AUTO_ID = mgId,
                                    EMP_AUTO_ID = empId,
                                    CREATE_BY = permission ?? "System",
                                    CREATE_TIME = DateTime.Now,
                                    MODIFY_BY = permission ?? "System",
                                    MODIFY_TIME = DateTime.Now,
                                    IS_ACTIVED = true,
                                    IS_DELETED = false
                                });
                            }
                        }
                        db.SaveChanges();
                    }
                }

                Log.Information("保存組別結束, 使用者權限: {permission}, 組別:{groupName}, 員工流水號:{employeeIds}",
                    permission, groupName, employeeIds);
                return Json(new { success = true, message = "保存成功！" });
            }
            catch (Exception ex)
            {
                Log.Error("保存組別錯誤, 使用者權限: {permission}, 組別:{groupName}, 員工流水號:{employeeIds}, 錯誤：{errMsg}",
                    permission, groupName, employeeIds, ex.Message);
                return Json(new { success = false, error = "保存分組過程中發生錯誤：" + ex.Message });
            }
        }



        // 從組別中移除成員
        [HttpPost]
        public JsonResult RemoveFromGroup(string groupName, long empId)
        {
            string permission = Session["Permission"]?.ToString();
            Log.Information("刪除員工與常用組別對應, 組別名稱: {groupName}, 員工流水號: {empId}, 使用者權限: {permission}",
                 groupName, empId, permission);

            try
            {
                // 找到常用群組 (RCS_GROUP)
                var group = db.RCS_GROUP.FirstOrDefault(g =>
                    g.GROUP_NAME == groupName
                    && g.IS_ACTIVED
                    && !g.IS_DELETED);

                if (group == null)
                {
                    Log.Error("找不到指定的常用組別, 常用組別名稱: {groupName}", groupName);
                    return Json(new { success = false, error = "找不到指定的分組！" });
                }

                // 確認該員工是否存在於該常用組別中
                var employeeGroup = db.RCS_EMPLOYEE_GROUP.FirstOrDefault(eg =>
                    eg.GROUP_AUTO_ID == group.AUTO_ID
                    && eg.EMP_AUTO_ID == empId
                    && eg.IS_ACTIVED
                    && !eg.IS_DELETED);

                if (employeeGroup == null)
                {
                    Log.Error("員工不在該分組中, 常用組別名稱: {groupName}, 員工流水號: {empId}", groupName, empId);
                    return Json(new { success = false, error = "員工不在該分組中！" });
                }

                // 標記該員工與常用組別的關係為刪除
                employeeGroup.IS_DELETED = true;
                employeeGroup.MODIFY_BY = permission ?? "System";
                employeeGroup.MODIFY_TIME = DateTime.Now;

                // 找到此常用群組對應到的所有會議群組 ID
                var meetingGroupIds = db.RCS_MEETING_GROUP_MAP
                    .Where(map => map.GROUP_AUTO_ID == group.AUTO_ID && !map.IS_DELETED)
                    .Select(map => map.MEETING_GROUP_AUTO_ID)
                    .Distinct()
                    .ToList();

                if (meetingGroupIds.Any())
                {
                    // 與 SaveGroup 同樣的邏輯：
                    // 「已結束 (MEETING_END <= Now) 的會議」不動它的 RCS_MEMBER
                    // 「尚未結束 (MEETING_END > Now)」的會議才標記刪除

                    // 找出尚未結束的會議群組 ID
                    var notEndedMeetingGroupIds = (
                        from mg in db.RCS_MEETING_GROUP
                        join mt in db.RCS_MEETING on mg.MEETING_AUTO_ID equals mt.AUTO_ID
                        where meetingGroupIds.Contains(mg.AUTO_ID)
                              && !mg.IS_DELETED
                              && !mt.IS_DELETED
                              && mt.MEETING_END > DateTime.Now
                        select mg.AUTO_ID
                    ).Distinct().ToList();

                    if (notEndedMeetingGroupIds.Any())
                    {
                        // 只針對「尚未結束」的會議群組，找該員工的 RCS_MEMBER，標記刪除
                        var membersToRemove = db.RCS_MEMBER
                            .Where(m => notEndedMeetingGroupIds.Contains(m.MEETING_GROUP_AUTO_ID)
                                     && m.EMP_AUTO_ID == empId
                                     && !m.IS_DELETED)
                            .ToList();

                        foreach (var mem in membersToRemove)
                        {
                            mem.IS_DELETED = true;
                            mem.MODIFY_BY = permission ?? "System";
                            mem.MODIFY_TIME = DateTime.Now;
                        }
                    }
                }

                db.SaveChanges();

                Log.Information("刪除員工與常用組別對應結束,常用組別名稱: {groupName}, 員工流水號: {empId}, 權限: {permission}",
                    groupName, empId, permission);

                return Json(new { success = true });
            }
            catch (Exception ex)
            {
                Log.Error("刪除員工與常用組別對應錯誤!,常用組別名稱: {groupName}, 員工流水號: {empId}",
                    groupName, empId);
                return Json(new { success = false, error = ex.Message });
            }
        }



        [AuthorizeFilter]
        public ActionResult Edit(long id)
        {
            string permission = Session["Permission"]?.ToString();
            Log.Information("進入編輯員工頁面, 使用者權限: {permission}, 員工流水號:{id}",
                permission, id);
            var employee = db.RCS_EMPLOYEES
                .Where(e => e.AUTO_ID == id)
                .Select(e => new EmployeeViewModel
                {
                    AutoId = e.AUTO_ID,
                    EmpName = e.EMP_NAME,
                    Department = e.DEPARTMENT,
                    Position = e.POSITION,
                    EmpNumber = e.EMP_NUMBER,
                    SalesDepID = e.SALES_DEP_ID,
                    Modify_Time = e.MODIFY_TIME
                })
                .FirstOrDefault();

            if (employee == null)
            {
                Log.Error("進入編輯員工頁面錯誤！, 使用者權限: {permission}, 員工流水號:{id}",
                permission, id);
                return HttpNotFound();
            }
            Log.Information("進入編輯員工頁面結束, 使用者權限: {permission}, 員工流水號:{id}",
                permission, id);
            return View(employee);
        }


        [HttpPost]
        public JsonResult Edit(EmployeeViewModel model)
        {
            string permission = Session["Permission"]?.ToString();
            Log.Information("編輯員工資料, 使用者權限: {permission}, 員工資料:{model}", permission, model);

            if (ModelState.IsValid)
            {
                var employee = db.RCS_EMPLOYEES.FirstOrDefault(e => e.AUTO_ID == model.AutoId);
                if (employee != null)
                {
                    employee.EMP_NAME = model.EmpName;
                    employee.DEPARTMENT = model.Department;
                    employee.POSITION = model.Position;
                    employee.EMP_NUMBER = model.EmpNumber;
                    employee.SALES_DEP_ID = model.SalesDepID;
                    employee.MODIFY_BY = permission ?? "System";
                    employee.MODIFY_TIME = DateTime.Now;

                    db.SaveChanges();
                    Log.Information("編輯員工資料成功, 使用者權限: {permission}, 員工資料:{model}", permission, model);

                    return Json(new { success = true });
                }
                return Json(new { success = false, message = "找不到該員工。" });
            }
            return Json(new { success = false, message = "資料驗證失敗。" });
        }


        [AuthorizeFilter]
        public ActionResult Delete(int id)
        {
            string permission = Session["Permission"]?.ToString();
            Log.Information("刪除員工資料頁面, 使用者權限: {permission}, 員工流水號: {id}",
                permission, id);
            var employee = db.RCS_EMPLOYEES.FirstOrDefault(e => e.AUTO_ID == id);
            if (employee == null)
            {
                Log.Error("刪除員工資料頁面錯誤！, 使用者權限: {permission}, 員工流水號: {id}",
                permission, id);
                return HttpNotFound();
            }
            Log.Information("刪除員工資料頁面結束, 使用者權限: {permission}, 員工流水號: {id}",
                permission, id);
            return View(employee);
        }

        [HttpPost]
        public JsonResult DeleteConfirmed(int id)
        {
            string permission = Session["Permission"]?.ToString();
            Log.Information("刪除員工資料頁面, 使用者權限: {permission}, 員工流水號: {id}",
                            permission, id);

            // 找到員工 (RCS_EMPLOYEES)
            var employee = db.RCS_EMPLOYEES.FirstOrDefault(e => e.AUTO_ID == id && !e.IS_DELETED);
            if (employee == null)
            {
                Log.Error("刪除員工資料錯誤, 找不到員工 => 使用者權限: {permission}, 員工ID: {id}",
                          permission, id);
                return Json(new { success = false, message = "找不到該員工！" });
            }

            // 標記該員工為刪除
            employee.IS_DELETED = true;
            employee.MODIFY_BY = permission ?? "System";
            employee.MODIFY_TIME = DateTime.Now;

            // 找到此員工與日常群組的所有對應 (RCS_EMPLOYEE_GROUP)，同樣標記刪除
            var employeeGroups = db.RCS_EMPLOYEE_GROUP
                .Where(eg => eg.EMP_AUTO_ID == id && !eg.IS_DELETED)
                .ToList();

            foreach (var eg in employeeGroups)
            {
                eg.IS_DELETED = true;
                eg.MODIFY_BY = permission ?? "System";
                eg.MODIFY_TIME = DateTime.Now;
            }

            // 找到「尚未開始」的會議中，該員工可能存在的 RCS_MEMBER 紀錄
            // 尚未開始： MEETING_START > Now
            // 關聯路徑： RCS_MEMBER -> RCS_MEETING_GROUP -> RCS_MEETING
            // EMP_AUTO_ID 一般會對應 RCS_MEMBER.EMP_AUTO_ID
            var now = DateTime.Now;
            var membersInUnstartedMeetings =
                (from mem in db.RCS_MEMBER
                 join mg in db.RCS_MEETING_GROUP on mem.MEETING_GROUP_AUTO_ID equals mg.AUTO_ID
                 join m in db.RCS_MEETING on mg.MEETING_AUTO_ID equals m.AUTO_ID
                 where mem.EMP_AUTO_ID == id
                       && !mem.IS_DELETED
                       && m.MEETING_START > now  // 會議尚未開始
                       && !m.IS_DELETED
                 select mem
                ).ToList();

            // 標記這些 RCS_MEMBER 紀錄為刪除
            foreach (var mem in membersInUnstartedMeetings)
            {
                mem.IS_DELETED = true;
                mem.MODIFY_BY = permission ?? "System";
                mem.MODIFY_TIME = DateTime.Now;
            }

            try
            {
                db.SaveChanges();
                Log.Information("刪除員工資料成功, 使用者權限: {permission}, 員工ID: {id}",
                                permission, id);
            }
            catch (Exception ex)
            {
                Log.Error("刪除員工資料發生錯誤 => {Error}, 使用者權限: {permission}, 員工ID: {id}",
                          ex.Message, permission, id);
                return Json(new { success = false, message = "刪除員工失敗：" + ex.Message });
            }

            Log.Information("刪除員工資料頁面結束, 使用者權限: {permission}, 員工ID: {id}",
                            permission, id);

            return Json(new { success = true });
        }


        protected override void Dispose(bool disposing)
        {
            if (disposing)
            {
                db.Dispose();
            }
            base.Dispose(disposing);
        }
    }
}
