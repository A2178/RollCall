@model RollCall.Models.EmployeeViewModel

@{
    ViewBag.Title = "Edit Employee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>編輯員工資料</h2>

<div class="form-horizontal">
    <hr />
    <div id="validationSummary" class="text-danger"></div>
    <input type="hidden" id="AutoId" value="@Model.AutoId" />

    <div class="form-group">
        @Html.Label("員工姓名", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <input type="text" id="EmpName" class="form-control" value="@Model.EmpName" />
        </div>
    </div>

    <div class="form-group">
        @Html.Label("航線", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <input type="text" id="Department" class="form-control" value="@Model.Department" />
        </div>
    </div>

    <div class="form-group">
        @Html.Label("職務", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <input type="text" id="Position" class="form-control" value="@Model.Position" />
        </div>
    </div>

    <div class="form-group">
        @Html.Label("員工編號", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <input type="text" id="EmpNumber" class="form-control" value="@Model.EmpNumber" />
        </div>
    </div>

    <div class="form-group">
        @Html.Label("業務所屬部門", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <select id="SalesDepID" name="SalesDepID" class="form-control">
                <option value="">請選擇</option>
                <option value="PS.TPE" @(Model.SalesDepID == "PS.TPE" ? "selected" : "")>PS.TPE</option>
                <option value="PC.TPE" @(Model.SalesDepID == "PC.TPE" ? "selected" : "")>PC.TPE</option>
                <option value="PS.TXG" @(Model.SalesDepID == "PS.TXG" ? "selected" : "")>PS.TXG</option>
                <option value="PC.TXG" @(Model.SalesDepID == "PC.TXG" ? "selected" : "")>PC.TXG</option>
                <option value="PS.KHH" @(Model.SalesDepID == "PS.KHH" ? "selected" : "")>PS.KHH</option>
                <option value="PC.KHH" @(Model.SalesDepID == "PC.KHH" ? "selected" : "")>PC.KHH</option>
            </select>
            @Html.ValidationMessageFor(model => model.SalesDepID, "", new { @class = "text-danger" })
        </div>
    </div>


    <div class="form-group">
        @Html.Label("上次修改時間", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <input type="text" id="ModifyTime" class="form-control"
                   value="@((Model.Modify_Time.HasValue ? Model.Modify_Time.Value.ToString("yyyy-MM-dd HH:mm:ss") : ""))"
                   readonly />
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="button" class="btn btn-primary" onclick="submitEmployeeEdit()">保存</button>
        </div>
    </div>
</div>

<div>
    @Html.ActionLink("返回員工資料表", "Index", null, new { @class = "btn btn-secondary" })
</div>

<script>
    function submitEmployeeEdit() {
        const allowedValues = ["PS.TPE", "PC.TPE", "PS.TXG", "PC.TXG", "PS.KHH", "PC.KHH"];

        const model = {
            AutoId: document.getElementById("AutoId").value,
            EmpName: document.getElementById("EmpName").value,
            Department: document.getElementById("Department").value,
            Position: document.getElementById("Position").value,
            EmpNumber: document.getElementById("EmpNumber").value,
            SalesDepID: document.getElementById("SalesDepID").value
        };

        // 驗證必要欄位
        if (!model.EmpName || !model.Department || !model.Position || !model.EmpNumber || !model.SalesDepID) {
            alert("請填寫所有欄位！");
            return;
        }

        if (!allowedValues.includes(model.SalesDepID)) {
            alert("業務所屬部門格式錯誤");
            return;
        }

        // 發送 AJAX 請求
        $.ajax({
            url: '/RCS_EMPLOYEES/Edit',
            type: 'POST',
            contentType: 'application/x-www-form-urlencoded',
            data: $.param(model),
            success: function (response) {
                if (response.success) {
                    alert("編輯成功！");
                    window.location.href = '/RCS_EMPLOYEES/Index';
                } else {
                    document.getElementById("validationSummary").innerText = response.message || "編輯失敗，請稍後再試。";
                }
            },
            error: function () {
                document.getElementById("validationSummary").innerText = "系統錯誤，請稍後再試。";
            }
        });
    }

</script>
