        [HttpGet]
        public ActionResult SearchEmployees(string empName)
        {
            string currentUser = Session["Permission"]?.ToString();
            try
            {
                // 搜尋員工資料表中匹配的員工
                var employees = db.RCS_EMPLOYEES
                    .Where(e => !e.IS_DELETED && e.EMP_NAME.Contains(empName) && e.CREATE_BY == currentUser)
                    .Select(e => new
                    {
                        EmpId = e.AUTO_ID,
                        EmpNumber = e.EMP_NUMBER,
                        EmpName = e.EMP_NAME,
                        Department = e.DEPARTMENT
                    })
                    .ToList();

                // 回傳搜尋結果
                return Json(new { success = true, data = employees }, JsonRequestBehavior.AllowGet);
            }
            catch (Exception ex)
            {
                // 捕捉錯誤
                return Json(new { success = false, message = "搜尋失敗：" + ex.Message }, JsonRequestBehavior.AllowGet);
            }
        }
        [HttpPost]
        public ActionResult AddSelectedEmployeesToMeeting(long meetingGroupId, List<long> empIds)
        {
            string currentUser = Session["Permission"].ToString();            
            try
            {
                var meetingGroup = db.RCS_MEETING_GROUP
                    .FirstOrDefault(mg => mg.AUTO_ID == meetingGroupId && !mg.IS_DELETED);

                if (meetingGroup == null)
                {
                    return Json(new { success = false, message = "找不到會議組別" });
                }

                // 先透過 meetingGroup 來找到對應的會議 (RCS_MEETING)
                var meeting = db.RCS_MEETING
                    .FirstOrDefault(m => m.AUTO_ID == meetingGroup.MEETING_AUTO_ID && !m.IS_DELETED);
                if (meeting == null)
                {
                    Log.Error("加入群組至會議組別錯誤：找不到對應會議, 使用者權限: {Permission}, 會議組別流水號: {meetingGroupId}",
                        currentUser, meetingGroupId);
                    return Json(new { success = false, message = "找不到對應會議" });
                }

                // 檢查會議是否已結束
                // (若 MEETING_END <= 現在時間，視為已結束，不允許新增)
                if (meeting.MEETING_END != null && meeting.MEETING_END <= DateTime.Now)
                {
                    string msg = "此會議已結束，無法再新增單獨成員。";
                    Log.Error("加入群組至會議組別錯誤：會議已結束, 使用者權限: {Permission}, 會議組別流水號: {meetingGroupId}",
                        currentUser, meetingGroupId);
                    return Json(new { success = false, message = msg });
                }

                foreach (var empId in empIds)
                {
                    var existingMember = db.RCS_MEMBER
                        .FirstOrDefault(m => m.MEETING_GROUP_AUTO_ID == meetingGroupId && m.EMP_AUTO_ID == empId);

                    if (existingMember == null)
                    {
                        db.RCS_MEMBER.Add(new RCS_MEMBER
                        {
                            AUTO_GUID = Guid.NewGuid(),
                            MEETING_GROUP_AUTO_ID = meetingGroupId,
                            EMP_AUTO_ID = empId,
                            CREATE_BY = Session["Permission"]?.ToString(),
                            CREATE_TIME = DateTime.Now,
                            MODIFY_BY = Session["Permission"]?.ToString(),
                            MODIFY_TIME = DateTime.Now,
                            IS_ACTIVED = true,
                            IS_DELETED = false
                        });
                    }
                    else if (existingMember.IS_DELETED)
                    {
                        existingMember.IS_DELETED = false;
                        existingMember.MODIFY_BY = Session["Permission"]?.ToString();
                        existingMember.MODIFY_TIME = DateTime.Now;
                    }
                }

                db.SaveChanges();
                return Json(new { success = true, message = "成員已成功加入會議" });
            }
            catch (Exception ex)
            {
                return Json(new { success = false, message = "新增失敗：" + ex.Message });
            }
        }



        [HttpGet]
        public ActionResult FilterMeetingMembers(long meetingId, long? meetingGroupId, long? dailyGroupId)
        {
            string currentUser = Session["Permission"]?.ToString();
            Log.Information("已加入的會議組別篩選, 使用者權限: {Permission}, 會議流水號: {meetingId}, 會議分組流水號: {meetingGroupId}, 常用群組流水號: {dailyGroupId}",
                currentUser, meetingId, meetingGroupId, dailyGroupId);

            try
            {
                // 取得屬於該會議的所有常用群組 ID
                var usedDailyGroupIds = db.RCS_MEETING_GROUP_MAP
                    .Where(map => map.RCS_MEETING_GROUP.MEETING_AUTO_ID == meetingId && !map.IS_DELETED)
                    .Select(map => map.GROUP_AUTO_ID)
                    .Distinct()
                    .ToList();

                // 取得所有常用群組與員工的對應關係 (僅包含指定常用群組的員工 ID)
                var employeeGroupIds = db.RCS_EMPLOYEE_GROUP
                    .Where(eg => !eg.IS_DELETED && usedDailyGroupIds.Contains(eg.GROUP_AUTO_ID))
                    .Select(eg => new { eg.EMP_AUTO_ID, eg.GROUP_AUTO_ID })
                    .ToList();

                // 初步查詢成員
                var initialQuery = from mem in db.RCS_MEMBER
                                   join emp in db.RCS_EMPLOYEES on mem.EMP_AUTO_ID equals emp.AUTO_ID
                                   join mg in db.RCS_MEETING_GROUP on mem.MEETING_GROUP_AUTO_ID equals mg.AUTO_ID
                                   where !mem.IS_DELETED
                                         && !emp.IS_DELETED
                                         && !mg.IS_DELETED
                                         && mg.MEETING_AUTO_ID == meetingId
                                         && mg.CREATE_BY == currentUser
                                   orderby emp.DEPARTMENT ascending
                                   select new
                                   {
                                       MemberAutoId = mem.AUTO_ID,
                                       MeetingGroupId = mg.AUTO_ID,
                                       MeetingGroupName = mg.GROUP_NAME,
                                       EmpId = emp.AUTO_ID,
                                       EmpNumber = emp.EMP_NUMBER,
                                       EmpName = emp.EMP_NAME,
                                       Department = emp.DEPARTMENT,
                                       Position = emp.POSITION,
                                   };

                // 提取資料到記憶體
                var initialResults = initialQuery.ToList();

                // 在記憶體中添加 IsFromDailyGroup 和 SourceGroupId
                var resultsWithFlags = initialResults.Select(x => new
                {
                    x.MemberAutoId,
                    x.MeetingGroupId,
                    x.MeetingGroupName,
                    x.EmpId,
                    x.EmpNumber,
                    x.EmpName,
                    x.Department,
                    x.Position,
                    IsFromDailyGroup = employeeGroupIds
                        .Any(eg => eg.EMP_AUTO_ID == x.EmpId && usedDailyGroupIds.Contains(eg.GROUP_AUTO_ID)),
                    SourceGroupId = employeeGroupIds
                        .Where(eg => eg.EMP_AUTO_ID == x.EmpId)
                        .Select(eg => eg.GROUP_AUTO_ID)
                        .FirstOrDefault()
                }).ToList();

                // 過濾條件 - 會議組別
                if (meetingGroupId.HasValue && meetingGroupId.Value > 0)
                {
                    resultsWithFlags = resultsWithFlags
                        .Where(x => x.MeetingGroupId == meetingGroupId.Value)
                        .ToList();
                }

                // 過濾條件 - 常用群組
                if (dailyGroupId.HasValue && dailyGroupId.Value > 0)
                {
                    resultsWithFlags = resultsWithFlags
                        .Where(x => x.IsFromDailyGroup && employeeGroupIds.Any(eg =>
                            eg.EMP_AUTO_ID == x.EmpId && eg.GROUP_AUTO_ID == dailyGroupId.Value))
                        .ToList();
                }
                else if (!dailyGroupId.HasValue || dailyGroupId.Value <= 0)
                {
                    resultsWithFlags = resultsWithFlags
                        .Where(x => x.IsFromDailyGroup) // 僅顯示來自常用群組的成員
                        .ToList();
                }

                // 確保每名員工在所有符合條件的會議組別中都能顯示
                var resultList = resultsWithFlags
                    .GroupBy(x => new { x.EmpId, x.MeetingGroupId }) // 按 EmpId 和 MeetingGroupId 分組
                    .Select(g => g.First()) // 每組取第一筆資料
                    .ToList();

                Log.Information("已加入的會議組別篩選成功, 使用者權限: {Permission}, 會議流水號: {meetingId}, 會議分組流水號: {meetingGroupId}, 常用群組流水號: {dailyGroupId}",
                    currentUser, meetingId, meetingGroupId, dailyGroupId);

                // 回傳 JSON
                return Json(new { success = true, data = resultList }, JsonRequestBehavior.AllowGet);
            }
            catch (Exception ex)
            {
                Log.Error("已加入的會議組別篩選失敗！, 使用者權限: {Permission}, 會議流水號: {meetingId}, 會議分組流水號: {meetingGroupId}, 常用群組流水號: {dailyGroupId}, 錯誤訊息: {ErrorMessage}",
                    currentUser, meetingId, meetingGroupId, dailyGroupId, ex.Message);

                // 捕獲錯誤，返回失敗訊息
                return Json(new { success = false, message = "篩選失敗：" + ex.Message }, JsonRequestBehavior.AllowGet);
            }
        }



        //編輯單獨成員時取得單獨成員資料的方法
        [HttpGet]
        public JsonResult GetSingleMemberDetails(long empId, long meetingId)
        {
            // 1. 找 RCS_MEMBER  where EMP_AUTO_ID == empId + 其 MEETING_GROUP_AUTO_ID屬於 meetingId
            //   (因為同個empId 可能在多個會議或組別, 這裡只限本會議)
            var query =
                from mem in db.RCS_MEMBER
                join emp in db.RCS_EMPLOYEES on mem.EMP_AUTO_ID equals emp.AUTO_ID
                join mg in db.RCS_MEETING_GROUP on mem.MEETING_GROUP_AUTO_ID equals mg.AUTO_ID
                where !mem.IS_DELETED && !emp.IS_DELETED && !mg.IS_DELETED
                      && mem.EMP_AUTO_ID == empId
                      && mg.MEETING_AUTO_ID == meetingId
                select new
                {
                    EmpId = emp.AUTO_ID,
                    EmpName = emp.EMP_NAME,
                    EmpNumber = emp.EMP_NUMBER,
                    Department = emp.DEPARTMENT,
                    Position = emp.POSITION,
                    MeetingGroupId = mg.AUTO_ID,
                    OriginalGroupName = mg.GROUP_NAME
                };

            var member = query.FirstOrDefault();
            if (member == null)
            {
                return Json(new { success = false, message = "找不到成員或成員已被刪除" }, JsonRequestBehavior.AllowGet);
            }

            return Json(new { success = true, data = member }, JsonRequestBehavior.AllowGet);
        }



        [HttpGet]
        public ActionResult FilterSingleMembers(long meetingId, long? meetingGroupId)
        {
            // 獲取當前使用者
            var currentUser = Session["Permission"]?.ToString();

            Log.Information("已加入的會議組別篩選(單獨加入成員), 使用者權限: {Permission}, 會議流水號: {meetingId}, 會議分組流水號: {meetingGroupId}",
                currentUser, meetingId, meetingGroupId);

            try
            {
                // 確定該會議的所有常用群組
                var usedDailyGroupIds = db.RCS_MEETING_GROUP_MAP
                    .Where(map => map.RCS_MEETING_GROUP.MEETING_AUTO_ID == meetingId && !map.IS_DELETED)
                    .Select(map => map.GROUP_AUTO_ID)
                    .Distinct()
                    .ToList();

                // 從 RCS_EMPLOYEE_GROUP 中找到屬於這些常用群組的員工
                var employeesInDailyGroups = db.RCS_EMPLOYEE_GROUP
                    .Where(eg => usedDailyGroupIds.Contains(eg.GROUP_AUTO_ID) && !eg.IS_DELETED)
                    .Select(eg => eg.EMP_AUTO_ID)
                    .Distinct()
                    .ToList();

                // 查詢單獨新增的成員，並根據會議與當前使用者篩選
                var query = from mem in db.RCS_MEMBER
                            join emp in db.RCS_EMPLOYEES on mem.EMP_AUTO_ID equals emp.AUTO_ID
                            join mg in db.RCS_MEETING_GROUP on mem.MEETING_GROUP_AUTO_ID equals mg.AUTO_ID
                            where !mem.IS_DELETED
                                  && !emp.IS_DELETED
                                  && !mg.IS_DELETED
                                  && mg.MEETING_AUTO_ID == meetingId // 限制為當前會議
                                  && mg.CREATE_BY == currentUser // 比對建立者
                                                                 // 確保成員不來自常用群組
                                  && !employeesInDailyGroups.Contains(mem.EMP_AUTO_ID)
                            orderby emp.DEPARTMENT ascending
                            select new
                            {
                                EmpId = emp.AUTO_ID,
                                EmpNumber = emp.EMP_NUMBER,
                                EmpName = emp.EMP_NAME,
                                Department = emp.DEPARTMENT,
                                Position = emp.POSITION,
                                MeetingGroupId = mg.AUTO_ID
                            };

                // 若有選擇會議組別 => 進一步過濾
                if (meetingGroupId.HasValue && meetingGroupId.Value > 0)
                {
                    query = query.Where(x => x.MeetingGroupId == meetingGroupId.Value);
                }

                var resultList = query.ToList();

                Log.Information("已加入的會議組別篩選(單獨加入成員)結束, 使用者權限: {Permission}, 會議流水號: {meetingId}, 會議分組流水號: {meetingGroupId}",
                    currentUser, meetingId, meetingGroupId);

                // 回傳 JSON
                return Json(new { success = true, data = resultList }, JsonRequestBehavior.AllowGet);
            }
            catch (Exception ex)
            {
                Log.Error("已加入的會議組別篩選(單獨加入成員)錯誤！, 使用者權限: {Permission}, 會議流水號: {meetingId}, 會議分組流水號: {meetingGroupId}, 錯誤訊息: {ErrorMessage}",
                    currentUser, meetingId, meetingGroupId, ex.Message);

                // 捕獲錯誤，返回失敗訊息
                return Json(new { success = false, message = "篩選失敗：" + ex.Message }, JsonRequestBehavior.AllowGet);
            }
        }






        [HttpPost]
        public JsonResult RemoveSingleMember(long empId, long meetingId)
        {
            var currentUser = Session["Permission"]?.ToString();

            Log.Information("刪除單獨加入成員, 使用者權限: {Permission}, 員工流水號: {empId}, 會議流水號: {meetingId}",
                currentUser, empId, meetingId);

            var meeting = db.RCS_MEETING
                .FirstOrDefault(m => m.AUTO_ID == meetingId && !m.IS_DELETED);

            if (meeting.MEETING_END != null && meeting.MEETING_END <= DateTime.Now)
            {
                string msg = "此會議已結束，無法再刪除單獨成員。";
                Log.Error("刪除單獨成員錯誤：會議已結束, 使用者權限: {Permission}, 會議流水號: {meetingId}",
                    currentUser, meetingId);
                return Json(new { success = false, message = msg });
            }

            //   找到 RCS_MEMBER
            var memList = (
                from mem in db.RCS_MEMBER
                join mg in db.RCS_MEETING_GROUP on mem.MEETING_GROUP_AUTO_ID equals mg.AUTO_ID
                where !mem.IS_DELETED && !mg.IS_DELETED
                      && mg.MEETING_AUTO_ID == meetingId
                      && mem.EMP_AUTO_ID == empId
                select mem
            ).ToList();

            if (!memList.Any())
            {
                Log.Error("刪除單獨加入成員錯誤！, 使用者權限: {Permission}, 員工流水號: {empId}, 會議流水號: {meetingId}",
                currentUser, empId, meetingId);
                return Json(new { success = false, message = "找不到該成員在本會議的紀錄" });
            }

            // 標記刪除
            foreach (var mem in memList)
            {
                mem.IS_DELETED = true;
                mem.DELETE_BY = Session["Permission"]?.ToString();
                mem.DELETE_TIME = DateTime.Now;
                mem.MODIFY_BY = Session["Permission"]?.ToString();
                mem.MODIFY_TIME = DateTime.Now;
            }

            try
            {
                db.SaveChanges();
                Log.Information("刪除單獨加入成員結束, 使用者權限: {Permission}, 員工流水號: {empId}, 會議流水號: {meetingId}",
                currentUser, empId, meetingId);
                return Json(new { success = true });
            }
            catch (Exception ex)
            {
                Log.Error("刪除單獨加入成員錯誤！, 使用者權限: {Permission}, 員工流水號: {empId}, 會議流水號: {meetingId}",
                currentUser, empId, meetingId);
                return Json(new { success = false, message = "刪除失敗：" + ex.Message });
            }
        }

        //刪除此常用群組
        [HttpPost]
        public ActionResult RemoveAllocatedGroup(long meetingGroupId, long dailyGroupId)
        {
            var currentUser = Session["Permission"]?.ToString();

            Log.Information("從會議組別刪除常用群組, 使用者權限: {Permission}, 會議組別流水號: {meetingGroupId}, 常用群組流水號: {dailyGroupId}",
                currentUser, meetingGroupId, dailyGroupId);

            

            // 找到會議組別 (RCS_MEETING_GROUP)
            var mgEntity = db.RCS_MEETING_GROUP
                .FirstOrDefault(mg => mg.AUTO_ID == meetingGroupId && !mg.IS_DELETED);
            if (mgEntity == null)
            {
                Log.Error("無法移除: 找不到會議組別 => 會議組別流水號: {meetingGroupId}", meetingGroupId);
                return Json(new { success = false, message = "找不到會議組別" });
            }

            // 先透過 meetingGroup 來找到對應的會議 (RCS_MEETING)
            var meeting = db.RCS_MEETING
                .FirstOrDefault(m => m.AUTO_ID == mgEntity.MEETING_AUTO_ID && !m.IS_DELETED);
            if (meeting == null)
            {
                Log.Error("移除常用群組錯誤：找不到對應會議, 使用者權限: {Permission}, 常用群組流水號: {dailyGroupId}, 會議組別流水號: {meetingGroupId}",
                    currentUser, dailyGroupId, meetingGroupId);
                return Json(new { success = false, message = "找不到對應會議" });
            }

            // 檢查會議是否已結束
            // (若 MEETING_END <= 現在時間，視為已結束，不允許移除)
            if (meeting.MEETING_END != null && meeting.MEETING_END <= DateTime.Now)
            {
                string msg = "此會議已結束，無法再移除常用群組對應。";
                Log.Error("移除常用群組錯誤：會議已結束, 使用者權限: {Permission}, 常用群組流水號: {dailyGroupId}, 會議組別流水號: {meetingGroupId}",
                    currentUser, dailyGroupId, meetingGroupId);
                return Json(new { success = false, message = msg });
            }

            // 找到常用群組 (RCS_GROUP)
            var dailyGroup = db.RCS_GROUP
                .FirstOrDefault(g => g.AUTO_ID == dailyGroupId && !g.IS_DELETED);
            if (dailyGroup == null)
            {
                Log.Error("無法移除: 找不到常用群組 => 常用群組流水號: {dailyGroupId}", dailyGroupId);
                return Json(new { success = false, message = "找不到常用群組" });
            }

            // 找到 RCS_MEETING_GROUP_MAP 中的對應記錄
            var mapping = db.RCS_MEETING_GROUP_MAP
                .FirstOrDefault(map => map.MEETING_GROUP_AUTO_ID == meetingGroupId
                                     && map.GROUP_AUTO_ID == dailyGroupId
                                     && !map.IS_DELETED);
            if (mapping == null)
            {
                Log.Error("無法移除: 未找到該常用群組與會議組別的對應記錄 => 會議組別流水號: {meetingGroupId}, 常用群組流水號: {dailyGroupId}",
                    meetingGroupId, dailyGroupId);
                return Json(new { success = false, message = "未找到該常用群組與會議組別的對應記錄" });
            }


            // 標記 RCS_MEETING_GROUP_MAP 為刪除
            mapping.IS_DELETED = true;
            mapping.MODIFY_BY = currentUser ?? "System";
            mapping.MODIFY_TIME = DateTime.Now;

            // 取得該常用群組內所有的員工 (若為空，也不阻擋後續流程)
            var empIdsInDailyGroup = db.RCS_EMPLOYEE_GROUP
                .Where(eg => eg.GROUP_AUTO_ID == dailyGroup.AUTO_ID && !eg.IS_DELETED)
                .Select(eg => eg.EMP_AUTO_ID)
                .ToList();

            // 如果還有員工 (empIdsInDailyGroup 不為空)，再去 RCS_MEMBER 裡把這些員工的記錄標記為刪除
            if (empIdsInDailyGroup.Any())
            {
                var members = db.RCS_MEMBER
                    .Where(m => m.MEETING_GROUP_AUTO_ID == mgEntity.AUTO_ID
                             && empIdsInDailyGroup.Contains(m.EMP_AUTO_ID)
                             && !m.IS_DELETED)
                    .ToList();

                // 就算這裡沒查到任何 member 也沒關係，一樣能繼續把對應關係移除
                foreach (var mem in members)
                {
                    mem.IS_DELETED = true;
                    mem.MODIFY_BY = currentUser ?? "System";
                    mem.MODIFY_TIME = DateTime.Now;
                }
            }

            // 儲存變更
            try
            {
                db.SaveChanges();
                Log.Information("從會議組別刪除常用群組完成, 使用者權限: {Permission}, 會議分組流水號: {meetingGroupId}, 常用群組流水號: {dailyGroupId}",
                    currentUser, meetingGroupId, dailyGroupId);
                return Json(new { success = true });
            }
            catch (Exception ex)
            {
                Log.Error("從會議組別刪除常用群組發生錯誤, Exception: {Error}, 會議組別流水號: {meetingGroupId}, 常用群組流水號:{dailyGroupId}",
                    ex.Message, meetingGroupId, dailyGroupId);
                return Json(new { success = false, message = "移除失敗：" + ex.Message });
            }
        }




        [HttpGet]
        public ActionResult CheckEmployeeName(string empName)
        {
            var currentUser = Session["Permission"]?.ToString();

            Log.Information("檢查是否存在員工, 使用者權限: {Permission}, 員工姓名: {empName}",
                currentUser, empName);

            if (string.IsNullOrEmpty(empName))
            {
                Log.Error("檢查是否存在員工錯誤！, 使用者權限: {Permission}, 員工姓名: {empName}",
                currentUser, empName);
                return Json(new { success = false, message = "未輸入員工姓名" }, JsonRequestBehavior.AllowGet);
            }

            // 查員工
            var emp = db.RCS_EMPLOYEES
                .FirstOrDefault(e => e.EMP_NAME == empName && !e.IS_DELETED);

            // 找不到 => 回傳失敗
            if (emp == null)
            {
                Log.Error("檢查是否存在員工錯誤！, 使用者權限: {Permission}, 員工姓名: {empName}",
                currentUser, empName);
                return Json(new { success = false, message = $"查無員工: {empName}" },
                            JsonRequestBehavior.AllowGet);
            }

            // 帶回員工ID、員工編號等
            var data = new
            {
                empId = emp.AUTO_ID,
                empName = emp.EMP_NAME,
                empNumber = emp.EMP_NUMBER,
            };

            Log.Information("檢查是否存在員工結束, 使用者權限: {Permission}, 員工姓名: {empName}",
                currentUser, empName);
            return Json(new { success = true, data = data },
                        JsonRequestBehavior.AllowGet);
        }

        [HttpGet]
        public ActionResult DownloadMemberList(Guid guid)
        {
            Log.Information("下載成員名單,使用者權限：{Permission}, 會議Guid: {guid}",
                Session["Permission"],
                guid);

            // 找對應的會議
            RCS_MEETING meeting = db.RCS_MEETING
                .FirstOrDefault(m => m.AUTO_GUID == guid && !m.IS_DELETED);
            if (meeting == null)
            {
                Log.Error("下載成員名單失敗！,使用者權限：{Permission}, 會議Guid: {guid}",
                    Session["Permission"], guid);
                return HttpNotFound("找不到會議");
            }

            // 透過 RCS_MEMBER + RCS_MEETING_GROUP + RCS_EMPLOYEES 做關聯查詢
            var query =
                from mem in db.RCS_MEMBER
                join mg in db.RCS_MEETING_GROUP on mem.MEETING_GROUP_AUTO_ID equals mg.AUTO_ID
                join emp in db.RCS_EMPLOYEES on mem.EMP_AUTO_ID equals emp.AUTO_ID
                where mg.MEETING_AUTO_ID == meeting.AUTO_ID
                      && !mem.IS_DELETED
                      && !mg.IS_DELETED
                      && !emp.IS_DELETED
                select new
                {
                    GroupName = mg.GROUP_NAME,
                    EmployeeName = emp.EMP_NAME
                };

            var allMembers = query.ToList();

            // 依 GROUP_NAME 分組
            var membersGroupedByGroupName = allMembers
                .Where(x => !string.IsNullOrEmpty(x.GroupName))
                .GroupBy(x => x.GroupName)
                .ToList();

            // 固定排序：PS.TPE, PC.TPE, PS.TXG, PC.TXG, PS.KHH, PC.KHH
            List<string> groupOrder = new List<string>
            {
                "PS.TPE", "PC.TPE", "PS.TXG", "PC.TXG", "PS.KHH", "PC.KHH"
            };

            membersGroupedByGroupName = membersGroupedByGroupName
                .OrderBy(g =>
                {
                    int idx = groupOrder.IndexOf(g.Key);
                    return idx >= 0 ? idx : int.MaxValue;
                })
                .ToList();

            // 開始產生 Excel (ClosedXML)
            using (var workbook = new XLWorkbook())
            {
                var worksheet = workbook.Worksheets.Add("人員名單");

                // 收集所有實際出現的分組名稱，按照排序結果來
                var groupNames = membersGroupedByGroupName.Select(g => g.Key).Distinct().ToList();

                // 寫入表頭 (第一列)
                int col = 1;
                foreach (var gName in groupNames)
                {
                    worksheet.Cell(1, col).Value = gName;
                    col++;
                }

                // 找出最多成員數量
                int maxRows = membersGroupedByGroupName.Any()
                    ? membersGroupedByGroupName.Max(g => g.Count())
                    : 0;

                // 寫入成員資料
                for (int row = 2; row <= maxRows + 1; row++)
                {
                    col = 1;
                    foreach (var gName in groupNames)
                    {
                        var groupData = membersGroupedByGroupName.FirstOrDefault(g => g.Key == gName);
                        if (groupData != null)
                        {
                            // 查出該群組的第 (row - 2) 筆
                            var member = groupData.ElementAtOrDefault(row - 2);
                            if (member != null)
                            {
                                worksheet.Cell(row, col).Value = member.EmployeeName;
                            }
                        }
                        col++;
                    }
                }

                // 自動調整欄寬
                worksheet.Columns().AdjustToContents();

                // 產生 Excel 檔案
                using (var stream = new MemoryStream())
                {
                    workbook.SaveAs(stream);
                    byte[] fileBytes = stream.ToArray();
                    string currentTime = DateTime.Now.ToString("yyyyMMddHHmmss");

                    Log.Information("下載成員名單結束,使用者權限：{Permission}, 會議Guid: {guid}",
                        Session["Permission"], guid);

                    return File(fileBytes,
                        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                        $"{meeting.MEETING_NAME}人員名單_{currentTime}.xlsx");
                }
            }
        }

        public ActionResult DownloadMeetingLink(Guid guid)
        {
            Log.Information("下載會議連結,使用者權限：{Permission}, 會議Guid: {guid}",
                Session["Permission"],
                guid);

            // 根據 GUID 找到對應的會議資料
            RCS_MEETING meeting = db.RCS_MEETING.FirstOrDefault(m => m.AUTO_GUID == guid);
            if (meeting == null)
            {
                Log.Error("下載會議連結失敗！,使用者權限：{Permission}, 會議Guid: {guid}",
                    Session["Permission"],
                    guid);
                return HttpNotFound("會議未找到");
            }

            // 生成會議抽籤頁面的 URL
            string meetingLink = Url.Action("Index", "Raffle", new { guid = meeting.AUTO_GUID }, protocol: Request.Url.Scheme);

            // 產生.url檔案的內容
            string urlContent = "[InternetShortcut]\n";
            urlContent += $"URL={meetingLink}\n";
            urlContent += $"IDList=\n";
            urlContent += $"HotKey=0\n";
            urlContent += $"IconFile=explorer.exe,1\n";

            byte[] byteArray = Encoding.UTF8.GetBytes(urlContent);

            Log.Information("下載會議連結結束,使用者權限：{Permission}, 會議Guid: {guid}",
                Session["Permission"],
                guid);

            return File(byteArray, "application/octet-stream", $"{meeting.MEETING_NAME}.url");
        }

        public ActionResult DownloadRaffleLog(Guid guid)
        {
            Log.Information("下載抽籤紀錄,使用者權限：{Permission}, 會議Guid: {guid}",
                Session["Permission"],
                guid);

            // 根據傳入的 GUID 找出對應會議紀錄
            RCS_MEETING meeting = db.RCS_MEETING.FirstOrDefault(m => m.AUTO_GUID == guid);
            if (meeting == null)
            {
                Log.Error("下載抽籤紀錄失敗！,使用者權限：{Permission}, 會議Guid: {guid}",
                    Session["Permission"],
                    guid);
                return HttpNotFound("會議未找到");
            }

            long meetingId = meeting.AUTO_ID;
            string meetingName = meeting.MEETING_NAME;

            // 判斷會議是否已經開始
            DateTime currentTime = DateTime.Now;
            bool isTestPeriod = currentTime < meeting.MEETING_START;

            // 查詢對應會議的抽籤記錄
            var raffleLogs = (from callLog in db.RCS_CALL_LOG
                              join employee in db.RCS_EMPLOYEES on callLog.EMP_AUTO_ID equals employee.AUTO_ID
                              join meetingGroup in db.RCS_MEETING_GROUP on callLog.MEETING_GROUP_AUTO_ID equals meetingGroup.AUTO_ID
                              where callLog.IS_ACTIVED && !callLog.IS_DELETED &&
                                    employee.IS_ACTIVED &&
                                    meetingGroup.IS_ACTIVED && !meetingGroup.IS_DELETED &&
                                    meetingGroup.MEETING_AUTO_ID == meetingId
                              select new RaffleLogViewModel
                              {
                                  MemberName = employee.EMP_NAME,
                                  GroupName = meetingGroup.GROUP_NAME,
                                  Round = callLog.ROUND,
                                  CreateTime = callLog.CREATE_TIME
                              }).ToList();

            // 如果會議尚未開始，只生成帶表頭的Excel文件
            if (isTestPeriod)
            {
                raffleLogs.Clear(); // 清空記錄，不寫入任何數據，只寫入表頭
            }
            else
            {
                // 過濾掉負回合數，只保留正回合數的記錄
                raffleLogs = raffleLogs.Where(log => log.Round >= 0).ToList();
            }

            // 使用 ClosedXML 產生 Excel 文件
            using (var workbook = new XLWorkbook())
            {
                var worksheet = workbook.Worksheets.Add("抽籤紀錄");

                // 設定表頭
                worksheet.Cell(1, 1).Value = "組別名稱";
                worksheet.Cell(1, 2).Value = "成員名稱";
                worksheet.Cell(1, 3).Value = "回合數";
                worksheet.Cell(1, 4).Value = "抽籤時間";

                int row = 2; // 從第2列開始寫入(第1列為表頭)
                foreach (RaffleLogViewModel log in raffleLogs)
                {
                    worksheet.Cell(row, 1).Value = log.GroupName;
                    worksheet.Cell(row, 2).Value = log.MemberName;

                    // 如果回合數是負數，讓該欄位為空白
                    worksheet.Cell(row, 3).Value = log.Round >= 0 ? log.Round.ToString() : "";

                    worksheet.Cell(row, 4).Value = log.CreateTime.ToString("yyyy-MM-dd HH:mm:ss");
                    row++;
                }

                // 自動調整列寬
                worksheet.Columns().AdjustToContents();

                // 將生成的 Excel 轉換為 byte Array
                using (var stream = new MemoryStream())
                {
                    workbook.SaveAs(stream);
                    byte[] fileBytes = stream.ToArray();

                    // 當前時間，用於添加時間戳記於檔案結尾
                    string currentTimeStamp = DateTime.Now.ToString("yyyyMMddHHmmss");

                    Log.Information("下載抽籤紀錄結束,使用者權限：{Permission}, 會議Guid: {guid}",
                        Session["Permission"],
                        guid);

                    // 回傳 Excel 檔案，檔案名為 "抽籤紀錄_{會議名稱}.xlsx"
                    return File(fileBytes, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                                $"抽籤紀錄_{meetingName}_{currentTimeStamp}.xlsx");
                }
            }
        }



        public ActionResult Error()
        {
            return View(); // 這將會呈現位於 Views/Shared/Error.cshtml 的錯誤頁面
        }

        public ActionResult DownloadTemplate()
        {
            string RequestIp = Request.UserHostAddress;
            string serverMachineName = Environment.MachineName;
            string requestMethod = Request.HttpMethod;
            string requestUrl = Request.Url?.AbsoluteUri;
            string requestUserAgent = Request.UserAgent;
            string RequestHost = Request.UserHostAddress;
            string requestReferrer = Request.UrlReferrer?.ToString();
            string workMachine = Request.Url?.Host + ":" + Request.Url?.Port;
            string requestHeaders = string.Join("; ", Request.Headers.AllKeys.Select(key => key + ": " + Request.Headers[key]));

            Log.Information("下載人員名單範本,使用者權限：{Permission}", Session["Permission"]);

            string filePath = Server.MapPath("~/Content/files/抽籤人員名單模板.xlsx");
            byte[] fileBytes = System.IO.File.ReadAllBytes(filePath);
            string fileName = "抽籤人員名單模板.xlsx";

            Log.Information("下載人員名單範本結束,使用者權限：{Permission}", Session["Permission"]);

            return File(fileBytes, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", fileName);
        }


        [HttpGet]
        public ActionResult GenerateSignInSheet(long meetingGroupId)
        {
            Log.Information("下載簽到表,使用者權限：{Permission}, 會議分組流水號: {meetingGroupId}",
                        Session["Permission"],
                        meetingGroupId);
            try
            {
                // 取得會議組別資訊
                var meetingGroup = db.RCS_MEETING_GROUP
                    .FirstOrDefault(mg => mg.AUTO_ID == meetingGroupId && !mg.IS_DELETED);
                if (meetingGroup == null)
                {
                    Log.Error("下載簽到表錯誤！,使用者權限：{Permission}, 會議分組流水號: {meetingGroupId}",
                        Session["Permission"],
                        meetingGroupId);
                    return Json(new { success = false, message = "找不到會議組別" }, JsonRequestBehavior.AllowGet);
                }

                // 取得會議資訊
                var meeting = db.RCS_MEETING
                    .FirstOrDefault(m => m.AUTO_ID == meetingGroup.MEETING_AUTO_ID && !m.IS_DELETED);
                if (meeting == null)
                {
                    Log.Error("下載簽到表錯誤！,使用者權限：{Permission}, 會議分組流水號: {meetingGroupId}",
                        Session["Permission"],
                        meetingGroupId);
                    return Json(new { success = false, message = "找不到對應的會議" }, JsonRequestBehavior.AllowGet);
                }

                // 取得該會議組別的所有成員
                var members = (from mem in db.RCS_MEMBER
                               join emp in db.RCS_EMPLOYEES on mem.EMP_AUTO_ID equals emp.AUTO_ID
                               where mem.MEETING_GROUP_AUTO_ID == meetingGroupId
                                     && !mem.IS_DELETED && !emp.IS_DELETED
                               orderby emp.DEPARTMENT ascending
                               select new
                               {
                                   Department = emp.DEPARTMENT,
                                   Name = emp.EMP_NAME
                               }).ToList();

                if (!members.Any())
                {
                    Log.Error("下載簽到表錯誤！,使用者權限：{Permission}, 會議分組流水號: {meetingGroupId}",
                        Session["Permission"],
                        meetingGroupId);
                    return Json(new { success = false, message = "該會議組別無成員資料" }, JsonRequestBehavior.AllowGet);
                }

                // 簽到表樣板路徑
                var templatePath = Server.MapPath("~/Content/files/SignInSheet.xlsx");
                const int maxMembersPerSheet = 19;
                int totalSheets = (int)Math.Ceiling((double)members.Count / maxMembersPerSheet);

                using (var workbook = new XLWorkbook())
                {
                    for (int sheetIndex = 0; sheetIndex < totalSheets; sheetIndex++)
                    {
                        using (var templateWorkbook = new XLWorkbook(templatePath))
                        {
                            var templateSheet = templateWorkbook.Worksheet(1);
                            string sheetName = $"簽到表{sheetIndex + 1}";

                            var sheet = templateSheet.CopyTo(workbook, sheetName);

                            // 填充表頭資訊
                            sheet.Cell("C2").Value = meeting.MEETING_NAME;
                            sheet.Cell("B3").Value = "站別: " + meetingGroup.GROUP_NAME;
                            sheet.Cell("C3").Value = "講師: " + meeting.LECTURER;
                            sheet.Cell("D3").Value = "日期: " + meeting.MEETING_START?.ToString("yyyy/MM/dd");

                            workbook.Worksheet(sheetName).SetShowGridLines(false);


                            // 填充成員資料
                            int startRow = 5;
                            int startIndex = sheetIndex * maxMembersPerSheet;
                            int endIndex = Math.Min(startIndex + maxMembersPerSheet, members.Count);

                            for (int i = startIndex; i < endIndex; i++)
                            {
                                var member = members[i];
                                sheet.Cell(startRow, 2).Value = member.Department;
                                sheet.Cell(startRow, 3).Value = member.Name;
                                sheet.Cell(startRow, 4).Value = ""; // 簽到欄位
                                startRow++;
                            }
                        }
                    }

                    // 設定下載檔案名稱
                    var fileName = $"{meeting.MEETING_NAME}_簽到表_{meetingGroup.GROUP_NAME}_{DateTime.Now:yyyyMMddHHmmss}.xlsx";
                    using (var memoryStream = new MemoryStream())
                    {
                        workbook.SaveAs(memoryStream);
                        memoryStream.Position = 0;
                        Log.Information("下載簽到表結束,使用者權限：{Permission}, 會議分組流水號: {meetingGroupId}",
                        Session["Permission"],
                        meetingGroupId);
                        return File(memoryStream.ToArray(),
                                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                                    fileName);
                    }
                }
            }
            catch (Exception ex)
            {
                Log.Error("下載簽到表錯誤！,使用者權限：{Permission}, 會議分組流水號: {meetingGroupId}",
                        Session["Permission"],
                        meetingGroupId);
                return Json(new { success = false, message = "生成簽到表失敗：" + ex.Message }, JsonRequestBehavior.AllowGet);
            }
        }
    }
}
