        [HttpPost]
        [AuthorizeFilter]
        public ActionResult RemoveMember(long memberId)
        {
            string RequestIp = Request.UserHostAddress;
            string serverMachineName = Environment.MachineName;
            string requestMethod = Request.HttpMethod;
            string requestUrl = Request.Url?.AbsoluteUri;
            string requestUserAgent = Request.UserAgent;
            string RequestHost = Request.UserHostAddress;
            string requestReferrer = Request.UrlReferrer?.ToString();
            string workMachine = Request.Url?.Host + ":" + Request.Url?.Port;
            string requestHeaders = string.Join("; ", Request.Headers.AllKeys.Select(key => key + ": " + Request.Headers[key]));

            Log.Information("刪除成員,使用者權限：{Permission}, 被刪除成員ID: {memberId}",
                Session["Permission"],
                memberId);

            // 查詢要刪除的成員
            RCS_MEMBER member = db.RCS_MEMBER.FirstOrDefault(m => m.AUTO_ID == memberId);
            if (member == null)
            {
                Log.Error("刪除成員失敗！,使用者權限：{Permission}, 被刪除成員ID: {memberId}",
                    Session["Permission"],
                    memberId);

                return Json(new { success = false, message = "成員未找到" });
            }

            member.IS_DELETED = true;
            member.MODIFY_BY = Session["Permission"].ToString();
            member.MODIFY_TIME = DateTime.Now;
            member.DELETE_BY = Session["Permission"].ToString();
            member.DELETE_TIME = DateTime.Now;

            db.SaveChanges();

            Log.Information("刪除成員結束,使用者權限：{Permission}, 被刪除成員ID: {memberId}",
                Session["Permission"],
                memberId);

            return Json(new { success = true });
        }

        [AuthorizeFilter]
        public ActionResult Edit(Guid? guid)
        {
            var currentUser = Session["Permission"]?.ToString();

            Log.Information("進入會議資料編輯頁面, 使用者權限：{Permission}, 會議Guid: {guid}", currentUser, guid);

            if (guid == null)
            {
                Log.Error("進入會議資料編輯頁面失敗！, 使用者權限：{Permission}, 會議Guid: {guid}", currentUser, guid);
                return new HttpStatusCodeResult(HttpStatusCode.BadRequest);
            }

            var meeting = db.RCS_MEETING.FirstOrDefault(m => m.AUTO_GUID == guid && !m.IS_DELETED);

            // 查出當前使用者建立的常用群組
            var dailyGroupList = db.RCS_GROUP
                .Where(g => !g.IS_DELETED && g.CREATE_BY == currentUser)
                .ToList();

            // 查出這場會議的 RCS_MEETING_GROUP
            var meetingGroupsList = db.RCS_MEETING_GROUP
                .Where(mg => mg.MEETING_AUTO_ID == meeting.AUTO_ID && !mg.IS_DELETED && mg.CREATE_BY == currentUser)
                .ToList();

            // 查所有員工
            var employeesList = db.RCS_EMPLOYEES
                .Where(e => !e.IS_DELETED)
                .ToList();

            long meetingId = meeting.AUTO_ID; // 取得本場會議 ID

            // 取得以常用組別加入的資料
            var usedDailyGroupIds = (
                from map in db.RCS_MEETING_GROUP_MAP
                join mg in db.RCS_MEETING_GROUP on map.MEETING_GROUP_AUTO_ID equals mg.AUTO_ID
                where !map.IS_DELETED && !mg.IS_DELETED && mg.MEETING_AUTO_ID == meetingId && mg.CREATE_BY == currentUser
                select map.GROUP_AUTO_ID // 常用群組的 ID
            ).Distinct().ToList();

            // 取得常用組別中的員工 ID
            var employeesInDailyGroups = db.RCS_EMPLOYEE_GROUP
                .Where(eg => usedDailyGroupIds.Contains(eg.GROUP_AUTO_ID) && !eg.IS_DELETED)
                .Select(eg => eg.EMP_AUTO_ID)
                .Distinct()
                .ToList();

            // 再 join RCS_GROUP, 取得常用群組的資料
            var usedDailyGroupList = (
                from g in db.RCS_GROUP
                where usedDailyGroupIds.Contains(g.AUTO_ID)
                      && !g.IS_DELETED
                      && g.CREATE_BY == currentUser
                orderby g.GROUP_NAME
                select g
            ).ToList();

            // 取得成員並標記 IsFromDailyGroup
            var members = (
                from mem in db.RCS_MEMBER
                join emp in db.RCS_EMPLOYEES on mem.EMP_AUTO_ID equals emp.AUTO_ID
                join mg in db.RCS_MEETING_GROUP on mem.MEETING_GROUP_AUTO_ID equals mg.AUTO_ID
                where !mem.IS_DELETED && !emp.IS_DELETED && !mg.IS_DELETED && mg.MEETING_AUTO_ID == meetingId && mg.CREATE_BY == currentUser
                select new SingleMemberViewModel
                {
                    EmpId = emp.AUTO_ID,
                    EmpNumber = emp.EMP_NUMBER,
                    EmpName = emp.EMP_NAME,
                    Department = emp.DEPARTMENT,
                    Position = emp.POSITION,
                    MeetingGroupName = mg.GROUP_NAME,
                    IsFromDailyGroup = employeesInDailyGroups.Contains(emp.AUTO_ID) // 判斷是否屬於常用群組
                }
            ).ToList();

            // 將成員分類
            var singleMembers = members.Where(m => !m.IsFromDailyGroup).ToList();

            // 組合 MeetingGroups (頁面分組呈現人員)
            var meetingGroups = new List<MeetingGroupViewModel>();
            foreach (var mgEntity in meetingGroupsList)
            {
                var membersInGroup = members
                    .Where(m => m.MeetingGroupName == mgEntity.GROUP_NAME)
                    .Select(m => new MeetingMemberViewModel
                    {
                        MemberAutoId = m.EmpId, // 使用 EmpId 作為 MemberAutoId 的簡化
                        EmpAutoId = m.EmpId,
                        EmployeeName = m.EmpName
                    })
                    .ToList();

                meetingGroups.Add(new MeetingGroupViewModel
                {
                    AUTO_ID = mgEntity.AUTO_ID,
                    GROUP_NAME = mgEntity.GROUP_NAME,
                    Members = membersInGroup
                });
            }

            // 組出 ViewModel
            var viewModel = new MeetingEditViewModel
            {
                Meeting = meeting,
                DailyGroupList = dailyGroupList,
                MeetingGroupsList = meetingGroupsList,
                EmployeesList = employeesList,
                MeetingGroups = meetingGroups,
                UsedDailyGroupList = usedDailyGroupList,
                SingleMembers = singleMembers
            };

            Log.Information("進入會議資料編輯頁面結束, 使用者權限：{Permission}, 會議Guid: {guid}", currentUser, guid);

            return View(viewModel);
        }





        [HttpPost]
        [ValidateAntiForgeryToken]
        [AuthorizeFilter]
        public JsonResult Edit(MeetingEditViewModel viewModel)
        {
            string RequestIp = Request.UserHostAddress;
            string serverMachineName = Environment.MachineName;
            string requestMethod = Request.HttpMethod;
            string requestUrl = Request.Url?.AbsoluteUri;
            string requestUserAgent = Request.UserAgent;
            string RequestHost = Request.UserHostAddress;
            string requestReferrer = Request.UrlReferrer?.ToString();
            string workMachine = Request.Url?.Host + ":" + Request.Url?.Port;
            string requestHeaders = string.Join("; ", Request.Headers.AllKeys.Select(key => key + ": " + Request.Headers[key]));

            Log.Information("會議記錄編輯,使用者權限：{Permission}, 會議名稱: {meetingName}, 開始時間: {meetingStart}, 結束時間: {meetingEnd}",
                Session["Permission"],
                viewModel.Meeting.MEETING_NAME,
                viewModel.Meeting.MEETING_START,
                viewModel.Meeting.MEETING_END);

            if (ModelState.IsValid)
            {
                try
                {
                    // 查詢對應的會議記錄
                    RCS_MEETING existingMeeting = db.RCS_MEETING.FirstOrDefault(m => m.AUTO_ID == viewModel.Meeting.AUTO_ID);
                    if (existingMeeting == null)
                    {
                        Log.Error("會議記錄編輯失敗！,使用者權限：{Permission}, 會議名稱: {meetingName}, 開始時間: {meetingStart}, 結束時間: {meetingEnd}",
                            Session["Permission"],
                            viewModel.Meeting.MEETING_NAME,
                            viewModel.Meeting.MEETING_START,
                            viewModel.Meeting.MEETING_END);
                        return Json(new { success = false, message = "找不到該會議。" });
                    }

                    // 更新會議資料
                    existingMeeting.MEETING_NAME = viewModel.Meeting.MEETING_NAME;
                    existingMeeting.MEETING_START = viewModel.Meeting.MEETING_START;
                    existingMeeting.MEETING_END = viewModel.Meeting.MEETING_END;
                    existingMeeting.MODIFY_BY = Session["Permission"].ToString();
                    existingMeeting.MODIFY_TIME = DateTime.Now;

                    db.Entry(existingMeeting).State = EntityState.Modified;
                    db.SaveChanges();

                    Log.Information("會議記錄編輯結束,使用者權限：{Permission}, 會議名稱: {meetingName}, 開始時間: {meetingStart}, 結束時間: {meetingEnd}",
                        Session["Permission"],
                        viewModel.Meeting.MEETING_NAME,
                        viewModel.Meeting.MEETING_START,
                        viewModel.Meeting.MEETING_END);

                    // 成功返回
                    return Json(new { success = true });
                }
                catch (Exception ex)
                {
                    Log.Error("會議記錄編輯失敗！,使用者權限：{Permission}, 會議名稱: {meetingName}, 開始時間: {meetingStart}, 結束時間: {meetingEnd}",
                            Session["Permission"],
                            viewModel.Meeting.MEETING_NAME,
                            viewModel.Meeting.MEETING_START,
                            viewModel.Meeting.MEETING_END);
                    return Json(new { success = false, message = "更新會議資料時發生錯誤：" + ex.Message });
                }
            }
            Log.Error("會議記錄編輯失敗！,使用者權限：{Permission}, 會議名稱: {meetingName}, 開始時間: {meetingStart}, 結束時間: {meetingEnd}",
                            Session["Permission"],
                            viewModel.Meeting.MEETING_NAME,
                            viewModel.Meeting.MEETING_START,
                            viewModel.Meeting.MEETING_END);

            return Json(new { success = false, message = "請確認表單資料是否正確。" });
        }

        [HttpGet]
        public ActionResult GetUsedDailyGroupByMeetingGroup(long meetingGroupId)
        {
            string Permission = Session["Permission"]?.ToString();

            Log.Information("搜尋會議組別, 使用者權限：{Permission}, 會議組別: {meetingGroupId}",
                Permission, meetingGroupId);

            // 找到會議組別
            var meetingGroup = db.RCS_MEETING_GROUP
                .FirstOrDefault(mg => mg.AUTO_ID == meetingGroupId && !mg.IS_DELETED);
            if (meetingGroup == null)
            {
                Log.Error("會議組別搜尋錯誤！, 找不到該會議組別");
                return Json(new { success = false, message = "找不到該會議組別" }, JsonRequestBehavior.AllowGet);
            }

            // 查找常用群組與會議組別的有效對應關係
            var usedDailyGroups = (
                from map in db.RCS_MEETING_GROUP_MAP
                join grp in db.RCS_GROUP on map.GROUP_AUTO_ID equals grp.AUTO_ID
                where map.MEETING_GROUP_AUTO_ID == meetingGroupId
                      && !map.IS_DELETED
                      && !grp.IS_DELETED
                      && grp.CREATE_BY == Permission
                select new
                {
                    GroupId = grp.AUTO_ID,
                    GroupName = grp.GROUP_NAME
                }
            ).Distinct().ToList();

            Log.Information("搜尋會議組別結束, 使用者權限：{Permission}, 會議組別: {meetingGroupId}",
                Permission, meetingGroupId);

            return Json(new { success = true, data = usedDailyGroups }, JsonRequestBehavior.AllowGet);
        }




        [HttpGet]
        public ActionResult SearchGroup(string keyword)
        {
            var currentUser = Session["Permission"]?.ToString();

            Log.Information("搜尋自定義群組, 使用者權限: {Permission}, 關鍵字: {keyword}",
                currentUser, keyword);

            // 依照keyword篩選 RCS_GROUP 並檢查 CREATE_BY 是否為當前使用者
            IQueryable<RCS_GROUP> query = db.RCS_GROUP
                .Where(g => !g.IS_DELETED && g.CREATE_BY == currentUser);

            if (!string.IsNullOrEmpty(keyword))
            {
                query = query.Where(g => g.GROUP_NAME.Contains(keyword));
            }

            // 排序
            var groupList = query
                .OrderBy(g => g.GROUP_NAME)
                .Select(g => new
                {
                    g.AUTO_ID,
                    g.GROUP_NAME
                })
                .ToList();

            Log.Information("搜尋自定義群組結束, 使用者權限: {Permission}, 關鍵字: {keyword}, 結果數量: {count}",
                currentUser, keyword, groupList.Count);

            return Json(groupList, JsonRequestBehavior.AllowGet);
        }

        [HttpPost]
        public ActionResult UpdateMeeting(long meetingId, string meetingName,string lecturerName, string meetingStart, string meetingEnd)
        {
            var currentUser = Session["Permission"]?.ToString();

            Log.Information("更新會議資料, 使用者權限: {Permission},會議流水號: {meetingId}, 會議名稱: {meetingName}, 講師名稱: {lecturerName}, 開始時間: {meetingStart}, 結束時間: {meetingEnd}",
               currentUser, meetingId, meetingName, lecturerName, meetingStart, meetingEnd);

            // 找到會議
            var meeting = db.RCS_MEETING.FirstOrDefault(m => m.AUTO_ID == meetingId && !m.IS_DELETED);
            if (meeting == null)
            {
                Log.Error("更新會議資料錯誤！, 使用者權限: {Permission},會議流水號: {meetingId}, 會議名稱: {meetingName}, 講師名稱: {lecturerName}, 開始時間: {meetingStart}, 結束時間: {meetingEnd}",
                currentUser, meetingId, meetingName, lecturerName, meetingStart, meetingEnd);
                return Json(new { success = false, message = "找不到會議" });
            }

            DateTime? startTime = null;
            DateTime? endTime = null;
            try
            {
                startTime = DateTime.Parse(meetingStart);
                endTime = DateTime.Parse(meetingEnd);
            }
            catch
            {
                Log.Error("更新會議資料錯誤！, 使用者權限: {Permission},會議流水號: {meetingId}, 會議名稱: {meetingName}, 講師名稱: {lecturerName}, 開始時間: {meetingStart}, 結束時間: {meetingEnd}",
                currentUser, meetingId, meetingName, lecturerName, meetingStart, meetingEnd);
                return Json(new { success = false, message = "時間格式錯誤" });
            }

            // 更新欄位
            meeting.MEETING_NAME = meetingName;
            meeting.LECTURER = lecturerName;
            meeting.MEETING_START = startTime;
            meeting.MEETING_END = endTime;
            meeting.MODIFY_BY = Session["Permission"]?.ToString();
            meeting.MODIFY_TIME = DateTime.Now;

            try
            {
                db.SaveChanges();
                Log.Information("更新會議資料結束, 使用者權限: {Permission},會議流水號: {meetingId}, 會議名稱: {meetingName}, 講師名稱: {lecturerName}, 開始時間: {meetingStart}, 結束時間: {meetingEnd}",
                currentUser, meetingId, meetingName, lecturerName, meetingStart, meetingEnd);
                return Json(new { success = true });
            }
            catch (Exception ex)
            {
                Log.Error("更新會議資料錯誤！, 使用者權限: {Permission},會議流水號: {meetingId}, 會議名稱: {meetingName},開始時間: {meetingStart},結束時間: {meetingEnd}",
                currentUser, meetingId, meetingName, meetingStart, meetingEnd);
                return Json(new { success = false, message = "更新失敗：" + ex.Message });
            }
        }

        [HttpPost]
        public ActionResult CreateMeetingGroup(long meetingId, string groupName)
        {
            Log.Information("新增會議組別,使用者權限: {Permission},會議流水號: {meetingId},組別名稱: {groupName}",
                Session["Permission"],meetingId,groupName);
            //  找到會議
            var meeting = db.RCS_MEETING.FirstOrDefault(m => m.AUTO_ID == meetingId && !m.IS_DELETED);
            if (meeting == null)
            {
                Log.Error("新增會議組別錯誤！,使用者權限: {Permission},會議流水號: {meetingId},組別名稱: {groupName}",
                Session["Permission"], meetingId, groupName);
                return Json(new { success = false, message = "找不到對應會議" });
            }

            // 檢查是否已存在同名 GROUP_NAME
            var existing = db.RCS_MEETING_GROUP
                .FirstOrDefault(mg => mg.MEETING_AUTO_ID == meeting.AUTO_ID
                                   && mg.GROUP_NAME == groupName
                                   && !mg.IS_DELETED);
            if (existing != null)
            {
                Log.Error("新增會議組別錯誤！,使用者權限: {Permission},會議流水號: {meetingId},組別名稱: {groupName}",
                Session["Permission"], meetingId, groupName);
                return Json(new { success = false, message = "已存在相同名稱的會議組別" });
            }

            // 檢查會議是否已結束
            // (若 MEETING_END <= 現在時間，視為已結束，不允許移除)
            if (meeting.MEETING_END != null && meeting.MEETING_END <= DateTime.Now)
            {
                string msg = "此會議已結束，無法再新增會議組別。";
                Log.Error("新增會議組別錯誤：會議已結束, 使用者權限: {Permission}, 組別名稱: {meetingGroupId}",
                    Session["Permission"], groupName);
                return Json(new { success = false, message = msg });
            }

            // 建立新群組
            var mgEntity = new RCS_MEETING_GROUP
            {
                AUTO_GUID = Guid.NewGuid(),
                MEETING_AUTO_ID = meeting.AUTO_ID,
                GROUP_NAME = groupName,
                CREATE_BY = Session["Permission"]?.ToString(),
                CREATE_TIME = DateTime.Now,
                MODIFY_BY = Session["Permission"]?.ToString(),
                MODIFY_TIME = DateTime.Now,
                IS_ACTIVED = true,
                IS_DELETED = false
            };
            db.RCS_MEETING_GROUP.Add(mgEntity);

            try
            {
                db.SaveChanges();
                Log.Information("新增會議組別,使用者權限: {Permission},會議流水號: {meetingId},組別名稱: {groupName}",
                Session["Permission"], meetingId, groupName);
                return Json(new { success = true });
            }
            catch (Exception ex)
            {
                Log.Error("新增會議組別錯誤！,使用者權限: {Permission},會議流水號: {meetingId},組別名稱: {groupName}",
                Session["Permission"], meetingId, groupName);
                return Json(new { success = false, message = "建立失敗：" + ex.Message });
            }
        }

        [HttpPost]
        public ActionResult DeleteMeetingGroup(long meetingGroupId)
        {
            string currentUser = Session["Permission"]?.ToString() ?? "System";
            Log.Information("刪除會議組別, 使用者權限: {Permission}, 會議組別流水號: {meetingGroupId}",
                currentUser, meetingGroupId);

            // 1. 找到會議組別 (RCS_MEETING_GROUP)
            var mgEntity = db.RCS_MEETING_GROUP
                .FirstOrDefault(mg => mg.AUTO_ID == meetingGroupId && !mg.IS_DELETED);
            if (mgEntity == null)
            {
                Log.Error("刪除會議組別錯誤：找不到會議組別 => 使用者權限: {Permission}, meetingGroupId={meetingGroupId}",
                    currentUser, meetingGroupId);
                return Json(new { success = false, message = "找不到會議組別" });
            }

            // 2. 找到對應的會議 (RCS_MEETING)
            var meeting = db.RCS_MEETING
                .FirstOrDefault(m => m.AUTO_ID == mgEntity.MEETING_AUTO_ID && !m.IS_DELETED);
            if (meeting == null)
            {
                Log.Error("刪除會議組別錯誤：找不到對應會議 => 使用者權限: {Permission}, meetingGroupId={meetingGroupId}",
                    currentUser, meetingGroupId);
                return Json(new { success = false, message = "找不到對應會議" });
            }

            // 3. 檢查會議是否已結束 (若 MEETING_END <= 現在時間 => 視為已結束，不允許移除)
            if (meeting.MEETING_END != null && meeting.MEETING_END <= DateTime.Now)
            {
                string msg = "此會議已結束，無法再移除會議組別。";
                Log.Error("刪除會議組別錯誤：會議已結束 => 使用者權限: {Permission}, meetingGroupId={meetingGroupId}",
                    currentUser, meetingGroupId);
                return Json(new { success = false, message = msg });
            }

            // 4. 標記該會議組別 (RCS_MEETING_GROUP) 為已刪除
            mgEntity.IS_DELETED = true;
            mgEntity.MODIFY_BY = currentUser;
            mgEntity.MODIFY_TIME = DateTime.Now;

            // 5. 一併將與此會議組別相關的所有 RCS_MEMBER 標刪
            var members = db.RCS_MEMBER
                .Where(m => m.MEETING_GROUP_AUTO_ID == mgEntity.AUTO_ID && !m.IS_DELETED)
                .ToList();
            foreach (var mem in members)
            {
                mem.IS_DELETED = true;
                mem.MODIFY_BY = currentUser;
                mem.MODIFY_TIME = DateTime.Now;
            }

            // 6. 也要將 RCS_MEETING_GROUP_MAP 中 referencing 這個 meetingGroupId 的對應關係標刪
            var mappings = db.RCS_MEETING_GROUP_MAP
                .Where(map => map.MEETING_GROUP_AUTO_ID == meetingGroupId && !map.IS_DELETED)
                .ToList();

            foreach (var map in mappings)
            {
                map.IS_DELETED = true;
                map.MODIFY_BY = currentUser;
                map.MODIFY_TIME = DateTime.Now;
            }

            try
            {
                db.SaveChanges();
                Log.Information("刪除會議組別成功 => 使用者權限: {Permission}, meetingGroupId={meetingGroupId}",
                    currentUser, meetingGroupId);
                return Json(new { success = true });
            }
            catch (Exception ex)
            {
                Log.Error("刪除會議組別失敗 => 使用者權限: {Permission}, meetingGroupId={meetingGroupId}, error={ex}",
                    currentUser, meetingGroupId, ex.Message);
                return Json(new { success = false, message = "刪除失敗：" + ex.Message });
            }
        }


        //加入群組至會議組別
        [HttpPost]
        public ActionResult AssignDailyGroupToMeetingGroup(long dailyGroupId, long meetingGroupId)
        {
            var currentUser = Session["Permission"]?.ToString() ?? "System";

            Log.Information("加入常用群組至會議組別, 使用者權限: {Permission}, 常用群組流水號: {dailyGroupId}, 會議組別流水號: {meetingGroupId}",
                currentUser, dailyGroupId, meetingGroupId);

            // 1. 檢查常用群組
            var dailyGroup = db.RCS_GROUP
                .FirstOrDefault(g => g.AUTO_ID == dailyGroupId && !g.IS_DELETED);
            if (dailyGroup == null)
            {
                Log.Error("找不到常用群組 => 使用者權限: {Permission}, 常用群組流水號: {dailyGroupId}, 會議組別流水號: {meetingGroupId}",
                    currentUser, dailyGroupId, meetingGroupId);
                return Json(new { success = false, message = "找不到常用群組" });
            }

            // 2. 檢查會議組別
            var meetingGroup = db.RCS_MEETING_GROUP
                .FirstOrDefault(mg => mg.AUTO_ID == meetingGroupId && !mg.IS_DELETED);
            if (meetingGroup == null)
            {
                Log.Error("找不到會議組別 => 使用者權限: {Permission}, 常用群組流水號: {dailyGroupId}, 會議組別流水號: {meetingGroupId}",
                    currentUser, dailyGroupId, meetingGroupId);
                return Json(new { success = false, message = "找不到會議組別" });
            }

            // 3. 找對應的會議
            var meeting = db.RCS_MEETING
                .FirstOrDefault(m => m.AUTO_ID == meetingGroup.MEETING_AUTO_ID && !m.IS_DELETED);
            if (meeting == null)
            {
                Log.Error("找不到對應會議 => 使用者權限: {Permission}, 常用群組流水號: {dailyGroupId}, 會議組別流水號: {meetingGroupId}",
                    currentUser, dailyGroupId, meetingGroupId);
                return Json(new { success = false, message = "找不到對應會議" });
            }

            // 4. 檢查會議是否已結束
            if (meeting.MEETING_END != null && meeting.MEETING_END <= DateTime.Now)
            {
                var msg = "此會議已結束，無法再分配新的常用群組。";
                Log.Error(msg + " => 使用者權限: {Permission}, 常用群組流水號: {dailyGroupId}, 會議組別流水號: {meetingGroupId}",
                    currentUser, dailyGroupId, meetingGroupId);
                return Json(new { success = false, message = msg });
            }

            // 5. 查詢日常群組中的所有員工
            var employeeList = db.RCS_EMPLOYEE_GROUP
                .Where(eg => eg.GROUP_AUTO_ID == dailyGroupId && !eg.IS_DELETED)
                .Select(eg => eg.EMP_AUTO_ID)
                .ToList();

            // 6. 修正：只檢查「該日常群組」是否已經跟「此 meetingGroupId」對應過
            //    而不再用 "map.RCS_MEETING_GROUP.MEETING_AUTO_ID == meetingGroup.MEETING_AUTO_ID"
            var existingMapping = db.RCS_MEETING_GROUP_MAP
                .FirstOrDefault(map =>
                     map.GROUP_AUTO_ID == dailyGroupId
                     && map.MEETING_GROUP_AUTO_ID == meetingGroupId);  // <-- 關鍵

            if (existingMapping != null)
            {
                if (!existingMapping.IS_DELETED)
                {
                    // 表示該日常群組已經分配到這個會議組別 (meetingGroupId)，請勿重複
                    var msg = "該常用群組已分配到此會議組別，請勿重複新增。";
                    Log.Error(msg + " => 使用者權限: {Permission}, 常用群組流水號: {dailyGroupId}, 會議組別流水號: {meetingGroupId}",
                        currentUser, dailyGroupId, meetingGroupId);
                    return Json(new { success = false, message = msg });
                }
                else
                {
                    // 恢復已刪除的 mapping
                    existingMapping.IS_DELETED = false;
                    existingMapping.MODIFY_BY = currentUser;
                    existingMapping.MODIFY_TIME = DateTime.Now;
                }
            }
            else
            {
                // 建立新的對應關係
                var newMapping = new RCS_MEETING_GROUP_MAP
                {
                    AUTO_GUID = Guid.NewGuid(),
                    GROUP_AUTO_ID = dailyGroupId,
                    MEETING_GROUP_AUTO_ID = meetingGroupId,
                    CREATE_BY = currentUser,
                    CREATE_TIME = DateTime.Now,
                    MODIFY_BY = currentUser,
                    MODIFY_TIME = DateTime.Now,
                    IS_ACTIVED = true,
                    IS_DELETED = false
                };
                db.RCS_MEETING_GROUP_MAP.Add(newMapping);
            }

            // 7. 新增或更新 RCS_MEMBER 資料
            //    若員工不存在 => 新增；若被標刪 => 恢復
            foreach (var empId in employeeList)
            {
                var existingMember = db.RCS_MEMBER
                    .FirstOrDefault(m => m.MEETING_GROUP_AUTO_ID == meetingGroupId && m.EMP_AUTO_ID == empId);

                if (existingMember == null)
                {
                    // 新增成員
                    db.RCS_MEMBER.Add(new RCS_MEMBER
                    {
                        AUTO_GUID = Guid.NewGuid(),
                        MEETING_GROUP_AUTO_ID = meetingGroupId,
                        EMP_AUTO_ID = empId,
                        CREATE_BY = currentUser,
                        CREATE_TIME = DateTime.Now,
                        MODIFY_BY = currentUser,
                        MODIFY_TIME = DateTime.Now,
                        IS_ACTIVED = true,
                        IS_DELETED = false
                    });
                }
                else if (existingMember.IS_DELETED)
                {
                    // 恢復已刪除的成員
                    existingMember.IS_DELETED = false;
                    existingMember.MODIFY_BY = currentUser;
                    existingMember.MODIFY_TIME = DateTime.Now;
                }
            }

            try
            {
                db.SaveChanges();
                Log.Information("加入群組至會議組別成功 => 使用者權限: {Permission}, 常用群組流水號: {dailyGroupId}, 會議組別流水號: {meetingGroupId}",
                    currentUser, dailyGroupId, meetingGroupId);
                return Json(new { success = true });
            }
            catch (Exception ex)
            {
                var msg = "操作失敗：" + ex.Message;
                Log.Error(msg + " => 使用者權限: {Permission}, 常用群組流水號: {dailyGroupId}, 會議組別流水號: {meetingGroupId}",
                    currentUser, dailyGroupId, meetingGroupId);
                return Json(new { success = false, message = msg });
            }
        }



